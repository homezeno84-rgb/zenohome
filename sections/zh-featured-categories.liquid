{{ 'zh-premium.css' | asset_url | stylesheet_tag }}

<section
  id="zh-featured-categories-{{ section.id }}"
  class="zh-featured-categories"
  style="
    background-color: {{ section.settings.background_color }};
    --pt: {{ section.settings.padding_top }}px;
    --pb: {{ section.settings.padding_bottom }}px;
    --cols: {{ section.settings.columns }};
    --cols-mobile: {{ section.settings.columns_mobile }};
  "
>
  <div class="zh-container">

    {%- comment -%} Section header {%- endcomment -%}
    {%- if section.settings.eyebrow != blank or section.settings.title != blank or section.settings.subtitle != blank -%}
      <div class="zh-section-header zh-anim">
        {%- if section.settings.eyebrow != blank -%}
          <p class="zh-section-header__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class="zh-section-header__title">{{ section.settings.title }}</h2>
        {%- endif -%}
        <div class="zh-section-header__divider" aria-hidden="true">
          <span class="zh-section-header__divider-line"></span>
          <span class="zh-section-header__divider-diamond"></span>
          <span class="zh-section-header__divider-line"></span>
        </div>
        {%- if section.settings.subtitle != blank -%}
          <p class="zh-section-header__subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} Category grid {%- endcomment -%}
    {%- if section.blocks.size > 0 -%}
      <div
        class="zh-featured-categories__grid zh-featured-categories__grid--{{ section.settings.style }}"
        role="list"
      >
        {%- for block in section.blocks -%}
          {%- assign coll = collections[block.settings.collection] -%}
          {%- assign card_url = block.settings.link | default: coll.url | default: '#' -%}
          {%- assign card_title = block.settings.custom_title | default: coll.title | default: 'Category' -%}

          {%- comment -%} Resolve image: custom > collection.image > first product image > placeholder {%- endcomment -%}
          {%- assign card_image = block.settings.custom_image -%}
          {%- if card_image == blank and coll != blank -%}
            {%- assign card_image = coll.image -%}
          {%- endif -%}
          {%- if card_image == blank and coll != blank and coll.products.first != blank -%}
            {%- assign card_image = coll.products.first.featured_image -%}
          {%- endif -%}

          <div
            class="zh-category-card zh-category-card--{{ section.settings.style }} zh-anim"
            role="listitem"
            style="--anim-delay: {{ forloop.index0 | times: 80 }}ms;"
            {{ block.shopify_attributes }}
          >
            <a href="{{ card_url }}" class="zh-category-card__link" aria-label="{{ card_title | escape }}">

              {%- comment -%} Card image {%- endcomment -%}
              <div class="zh-category-card__image-wrap">
                {%- if card_image != blank -%}
                  {{
                    card_image
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      widths: '300,400,600,800',
                      sizes: '(max-width: 767px) 50vw, 25vw',
                      class: 'zh-category-card__img',
                      alt: card_title | escape
                  }}
                {%- else -%}
                  {{ 'collection-1' | placeholder_svg_tag: 'zh-category-card__img zh-placeholder-img' }}
                {%- endif -%}

                {%- comment -%} Gradient overlay {%- endcomment -%}
                <div class="zh-category-card__overlay" aria-hidden="true"></div>

                {%- comment -%} Badge {%- endcomment -%}
                {%- if block.settings.badge != blank -%}
                  <span class="zh-category-card__badge">{{ block.settings.badge }}</span>
                {%- endif -%}
              </div>

              {%- comment -%} Card info {%- endcomment -%}
              <div class="zh-category-card__info">
                <h3 class="zh-category-card__title">{{ card_title }}</h3>
                {%- if block.settings.subtitle != blank -%}
                  <p class="zh-category-card__subtitle">{{ block.settings.subtitle }}</p>
                {%- endif -%}
                {%- if section.settings.show_product_count and coll != blank -%}
                  <p class="zh-category-card__count">
                    {{ coll.products_count }}
                    {{ 'collections.general.items' | t | default: 'items' }}
                  </p>
                {%- endif -%}
                <span class="zh-category-card__cta" aria-hidden="true">
                  {{ 'collections.general.view_all' | t | default: 'Shop Now' }}
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </span>
              </div>
            </a>
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="zh-featured-categories__empty">{{ 'sections.featured_categories.no_blocks' | t | default: 'Add category blocks in the Theme Editor.' }}</p>
    {%- endif -%}

  </div>
</section>

<style>
  #zh-featured-categories-{{ section.id }} {
    padding-top: var(--pt, 60px);
    padding-bottom: var(--pb, 60px);
  }

  /* Section header */
  #zh-featured-categories-{{ section.id }} .zh-section-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  #zh-featured-categories-{{ section.id }} .zh-section-header__eyebrow {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: #C9A84C;
    margin: 0 0 0.6rem;
  }

  #zh-featured-categories-{{ section.id }} .zh-section-header__title {
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    font-weight: 700;
    color: #1A1A2E;
    margin: 0 0 1rem;
    line-height: 1.15;
  }

  #zh-featured-categories-{{ section.id }} .zh-section-header__divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    margin-bottom: 1rem;
  }

  #zh-featured-categories-{{ section.id }} .zh-section-header__divider-line {
    display: block;
    width: 60px;
    height: 1px;
    background: #C9A84C;
    opacity: 0.5;
  }

  #zh-featured-categories-{{ section.id }} .zh-section-header__divider-diamond {
    display: block;
    width: 6px;
    height: 6px;
    background: #C9A84C;
    transform: rotate(45deg);
  }

  #zh-featured-categories-{{ section.id }} .zh-section-header__subtitle {
    font-size: 1rem;
    color: #555;
    max-width: 560px;
    margin: 0 auto;
    line-height: 1.7;
  }

  /* Grid layout */
  #zh-featured-categories-{{ section.id }} .zh-featured-categories__grid {
    display: grid;
    grid-template-columns: repeat(var(--cols, 4), 1fr);
    gap: 1.25rem;
  }

  /* Card base */
  #zh-featured-categories-{{ section.id }} .zh-category-card {
    position: relative;
    border-radius: 6px;
    overflow: hidden;
    animation-delay: var(--anim-delay, 0ms);
  }

  #zh-featured-categories-{{ section.id }} .zh-category-card__link {
    display: block;
    text-decoration: none;
    color: inherit;
    position: relative;
    overflow: hidden;
    border-radius: 6px;
  }

  /* Image wrap */
  #zh-featured-categories-{{ section.id }} .zh-category-card__image-wrap {
    position: relative;
    overflow: hidden;
  }

  /* Square style */
  #zh-featured-categories-{{ section.id }} .zh-featured-categories__grid--square .zh-category-card__image-wrap {
    aspect-ratio: 1 / 1;
  }

  /* Circle style */
  #zh-featured-categories-{{ section.id }} .zh-featured-categories__grid--circle .zh-category-card__image-wrap {
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    overflow: hidden;
  }

  #zh-featured-categories-{{ section.id }} .zh-featured-categories__grid--circle .zh-category-card__link {
    text-align: center;
  }

  #zh-featured-categories-{{ section.id }} .zh-featured-categories__grid--circle .zh-category-card__overlay {
    border-radius: 50%;
  }

  /* Tall style */
  #zh-featured-categories-{{ section.id }} .zh-featured-categories__grid--tall .zh-category-card__image-wrap {
    aspect-ratio: 3 / 4;
  }

  #zh-featured-categories-{{ section.id }} .zh-category-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.55s cubic-bezier(0.4, 0, 0.2, 1);
  }

  #zh-featured-categories-{{ section.id }} .zh-category-card__link:hover .zh-category-card__img {
    transform: scale(1.06);
  }

  /* Overlay gradient */
  #zh-featured-categories-{{ section.id }} .zh-category-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.65) 0%, rgba(0,0,0,0.12) 55%, transparent 100%);
    pointer-events: none;
  }

  /* Badge */
  #zh-featured-categories-{{ section.id }} .zh-category-card__badge {
    position: absolute;
    top: 0.75rem;
    inset-inline-start: 0.75rem;
    background: #C9A84C;
    color: #fff;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.25rem 0.6rem;
    border-radius: 2px;
    z-index: 2;
  }

  /* Card info — overlay variant (square/tall) */
  #zh-featured-categories-{{ section.id }} .zh-featured-categories__grid--square .zh-category-card__info,
  #zh-featured-categories-{{ section.id }} .zh-featured-categories__grid--tall .zh-category-card__info {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 1.25rem 1rem;
    color: #fff;
    z-index: 2;
  }

  /* Card info — circle variant (below image) */
  #zh-featured-categories-{{ section.id }} .zh-featured-categories__grid--circle .zh-category-card__info {
    padding: 0.75rem 0.5rem 0;
    text-align: center;
    color: #1A1A2E;
  }

  #zh-featured-categories-{{ section.id }} .zh-featured-categories__grid--circle .zh-category-card__overlay {
    opacity: 0;
  }

  #zh-featured-categories-{{ section.id }} .zh-category-card__title {
    font-size: 1rem;
    font-weight: 700;
    margin: 0 0 0.2rem;
    line-height: 1.2;
  }

  #zh-featured-categories-{{ section.id }} .zh-category-card__subtitle {
    font-size: 0.8rem;
    opacity: 0.85;
    margin: 0 0 0.3rem;
  }

  #zh-featured-categories-{{ section.id }} .zh-category-card__count {
    font-size: 0.75rem;
    opacity: 0.7;
    margin: 0 0 0.3rem;
  }

  #zh-featured-categories-{{ section.id }} .zh-category-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #C9A84C;
    transition: gap 0.2s;
  }

  #zh-featured-categories-{{ section.id }} .zh-category-card__link:hover .zh-category-card__cta {
    gap: 0.5rem;
  }

  #zh-featured-categories-{{ section.id }} .zh-featured-categories__empty {
    text-align: center;
    color: #888;
    padding: 2rem;
    font-size: 0.9rem;
  }

  /* Scroll animation */
  #zh-featured-categories-{{ section.id }} .zh-anim {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.55s ease, transform 0.55s ease;
    transition-delay: var(--anim-delay, 0ms);
  }

  #zh-featured-categories-{{ section.id }} .zh-anim.zh-anim--visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Container */
  #zh-featured-categories-{{ section.id }} .zh-container {
    max-width: 1280px;
    margin: 0 auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }

  /* Mobile */
  @media (max-width: 767px) {
    #zh-featured-categories-{{ section.id }} .zh-featured-categories__grid {
      grid-template-columns: repeat(var(--cols-mobile, 2), 1fr);
      gap: 0.75rem;
    }
  }
</style>

<script src="{{ 'zh-premium.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "ZH Featured Categories",
  "tag": "section",
  "class": "zh-section-featured-categories",
  "max_blocks": 10,
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Shop by Category"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle"
    },
    {
      "type": "header",
      "content": "Grid Options"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (Desktop)",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns (Mobile)",
      "min": 2,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "select",
      "id": "style",
      "label": "Card Style",
      "options": [
        { "value": "circle", "label": "Circle" },
        { "value": "square", "label": "Square" },
        { "value": "tall",   "label": "Tall (Portrait)" }
      ],
      "default": "square"
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "Show Product Count",
      "default": false
    },
    {
      "type": "header",
      "content": "Colors & Spacing"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FAFAF8"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Image (overrides collection image)"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom Title (overrides collection title)"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom Link (overrides collection URL)"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge Label (e.g. New, Sale)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ZH Featured Categories",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
