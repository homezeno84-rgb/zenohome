{% comment %} ZenoHome – Newsletter section {% endcomment %}

<link rel="stylesheet" href="{{ 'zh-premium.css' | asset_url }}">

{%- liquid
  assign dir = 'ltr'
  assign text_align = section.settings.text_align
  if request.locale.iso_code == 'ar'
    assign dir = 'rtl'
    assign text_align = 'right'
  endif
  assign bg_style = section.settings.background_style
-%}

{%- assign posted = false -%}
{%- if request.path contains '?' -%}
  {%- if request.path contains 'customer_posted=true' -%}
    {%- assign posted = true -%}
  {%- endif -%}
{%- endif -%}

<section
  class="zh-newsletter zh-newsletter--{{ bg_style }}"
  data-zh-newsletter
  dir="{{ dir }}"
  style="
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    {%- if bg_style == 'dark' or bg_style == 'gold' or bg_style == 'light' -%}
      background-color: {{ section.settings.background_color }};
    {%- elsif bg_style == 'image' and section.settings.background_image != blank -%}
      position: relative;
    {%- endif -%}
  "
>

  {%- if bg_style == 'image' and section.settings.background_image != blank -%}
    <div class="zh-newsletter-bg-image" aria-hidden="true">
      {{
        section.settings.background_image
        | image_url: width: 1920
        | image_tag:
          class: 'zh-newsletter-bg-img',
          alt: '',
          loading: 'lazy'
      }}
    </div>
    <div
      class="zh-newsletter-overlay"
      style="background-color: rgba(0,0,0,{{ section.settings.overlay_opacity | divided_by: 100.0 }});"
      aria-hidden="true"
    ></div>
  {%- endif -%}

  <div class="zh-container zh-newsletter-inner">
    <div
      class="zh-newsletter-content"
      style="text-align: {{ text_align }};"
    >
      {%- if section.settings.eyebrow != blank -%}
        <p class="zh-nl-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      {%- if section.settings.title != blank -%}
        <h2 class="zh-nl-title">{{ section.settings.title }}</h2>
      {%- endif -%}

      {%- if section.settings.subtitle != blank -%}
        <p class="zh-nl-subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}

      {%- if posted -%}
        <div class="zh-nl-success" role="alert">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="9 12 11 14 15 10"/></svg>
          {{ section.settings.success_message }}
        </div>
      {%- else -%}
        <form
          class="zh-nl-form"
          action="{{ routes.contact_url }}"
          method="POST"
          id="zh-nl-form-{{ section.id }}"
          novalidate
        >
          <input type="hidden" name="form_type" value="customer">
          <input type="hidden" name="utf8" value="✓">
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input type="hidden" name="redirect" value="{{ request.path }}?customer_posted=true">

          {%- if section.settings.show_name_field -%}
            <div class="zh-nl-field">
              <input
                type="text"
                name="contact[first_name]"
                id="zh-nl-name-{{ section.id }}"
                class="zh-nl-input"
                placeholder="{{ section.settings.name_placeholder | escape }}"
                autocomplete="given-name"
              >
            </div>
          {%- endif -%}

          <div class="zh-nl-row">
            <div class="zh-nl-field zh-nl-field--email">
              <label for="zh-nl-email-{{ section.id }}" class="visually-hidden">{{ section.settings.placeholder }}</label>
              <input
                type="email"
                name="contact[email]"
                id="zh-nl-email-{{ section.id }}"
                class="zh-nl-input"
                placeholder="{{ section.settings.placeholder | escape }}"
                autocomplete="email"
                required
                aria-required="true"
              >
            </div>
            <button type="submit" class="zh-nl-btn">
              {{ section.settings.button_text }}
            </button>
          </div>

          {%- if section.settings.show_gdpr -%}
            <div class="zh-nl-gdpr">
              <label class="zh-nl-gdpr-label">
                <input
                  type="checkbox"
                  name="contact[gdpr]"
                  value="1"
                  class="zh-nl-checkbox"
                  required
                >
                <span class="zh-nl-gdpr-text">{{ section.settings.gdpr_text }}</span>
              </label>
            </div>
          {%- endif -%}
        </form>

        {%- if section.settings.disclaimer != blank -%}
          <p class="zh-nl-disclaimer">{{ section.settings.disclaimer }}</p>
        {%- endif -%}
      {%- endif -%}

    </div>
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .zh-newsletter {
    position: relative;
    overflow: hidden;
  }

  /* Background image */
  #shopify-section-{{ section.id }} .zh-newsletter-bg-image {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  #shopify-section-{{ section.id }} .zh-newsletter-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #shopify-section-{{ section.id }} .zh-newsletter-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  #shopify-section-{{ section.id }} .zh-newsletter-inner {
    position: relative;
    z-index: 2;
  }

  /* Content width */
  #shopify-section-{{ section.id }} .zh-newsletter-content {
    max-width: 600px;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .zh-newsletter-content[style*="left"] {
    margin: 0;
  }

  /* Text colors by background style */
  #shopify-section-{{ section.id }} .zh-newsletter--dark .zh-nl-eyebrow,
  #shopify-section-{{ section.id }} .zh-newsletter--dark .zh-nl-title,
  #shopify-section-{{ section.id }} .zh-newsletter--dark .zh-nl-subtitle,
  #shopify-section-{{ section.id }} .zh-newsletter--dark .zh-nl-disclaimer,
  #shopify-section-{{ section.id }} .zh-newsletter--image .zh-nl-eyebrow,
  #shopify-section-{{ section.id }} .zh-newsletter--image .zh-nl-title,
  #shopify-section-{{ section.id }} .zh-newsletter--image .zh-nl-subtitle,
  #shopify-section-{{ section.id }} .zh-newsletter--image .zh-nl-disclaimer {
    color: #ffffff;
  }

  #shopify-section-{{ section.id }} .zh-newsletter--gold .zh-nl-eyebrow,
  #shopify-section-{{ section.id }} .zh-newsletter--gold .zh-nl-title,
  #shopify-section-{{ section.id }} .zh-newsletter--gold .zh-nl-subtitle,
  #shopify-section-{{ section.id }} .zh-newsletter--gold .zh-nl-disclaimer {
    color: #1a1a1a;
  }

  #shopify-section-{{ section.id }} .zh-newsletter--light .zh-nl-eyebrow,
  #shopify-section-{{ section.id }} .zh-newsletter--light .zh-nl-title,
  #shopify-section-{{ section.id }} .zh-newsletter--light .zh-nl-subtitle,
  #shopify-section-{{ section.id }} .zh-newsletter--light .zh-nl-disclaimer {
    color: #1a1a1a;
  }

  /* Eyebrow */
  #shopify-section-{{ section.id }} .zh-nl-eyebrow {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #C9A84C;
    margin-bottom: 14px;
  }

  #shopify-section-{{ section.id }} .zh-newsletter--gold .zh-nl-eyebrow {
    color: #1a1a1a;
    opacity: 0.6;
  }

  /* Title */
  #shopify-section-{{ section.id }} .zh-nl-title {
    font-size: clamp(28px, 4vw, 48px);
    font-weight: 700;
    line-height: 1.15;
    margin-bottom: 18px;
  }

  /* Subtitle */
  #shopify-section-{{ section.id }} .zh-nl-subtitle {
    font-size: 16px;
    line-height: 1.7;
    margin-bottom: 36px;
    opacity: 0.85;
  }

  /* Form */
  #shopify-section-{{ section.id }} .zh-nl-form {
    width: 100%;
  }

  #shopify-section-{{ section.id }} .zh-nl-field {
    margin-bottom: 12px;
  }

  #shopify-section-{{ section.id }} .zh-nl-row {
    display: flex;
    gap: 0;
    border-radius: 6px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0,0,0,0.15);
  }

  #shopify-section-{{ section.id }} .zh-nl-field--email {
    flex: 1;
    margin-bottom: 0;
  }

  #shopify-section-{{ section.id }} .zh-nl-input {
    width: 100%;
    height: 52px;
    padding: 0 18px;
    border: none;
    background: #ffffff;
    color: #1a1a1a;
    font-size: 15px;
    outline: none;
    font-family: inherit;
  }

  #shopify-section-{{ section.id }} .zh-nl-input::placeholder {
    color: #999;
  }

  #shopify-section-{{ section.id }} .zh-nl-input:focus {
    box-shadow: inset 0 0 0 2px #C9A84C;
  }

  #shopify-section-{{ section.id }} .zh-nl-btn {
    flex-shrink: 0;
    height: 52px;
    padding: 0 28px;
    background: #C9A84C;
    color: #1a1a1a;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border: none;
    cursor: pointer;
    font-family: inherit;
    white-space: nowrap;
    transition: background 0.2s ease, color 0.2s ease;
  }

  #shopify-section-{{ section.id }} .zh-nl-btn:hover {
    background: #b5902e;
    color: #fff;
  }

  /* GDPR */
  #shopify-section-{{ section.id }} .zh-nl-gdpr {
    margin-top: 14px;
  }

  #shopify-section-{{ section.id }} .zh-nl-gdpr-label {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .zh-nl-checkbox {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-top: 2px;
    accent-color: #C9A84C;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .zh-nl-gdpr-text {
    font-size: 13px;
    opacity: 0.8;
    line-height: 1.5;
  }

  /* Disclaimer */
  #shopify-section-{{ section.id }} .zh-nl-disclaimer {
    font-size: 12px;
    margin-top: 16px;
    opacity: 0.55;
    line-height: 1.5;
  }

  /* Success */
  #shopify-section-{{ section.id }} .zh-nl-success {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-size: 18px;
    font-weight: 600;
    color: #fff;
    background: rgba(255,255,255,0.12);
    border: 1px solid rgba(255,255,255,0.25);
    border-radius: 8px;
    padding: 20px 28px;
  }

  #shopify-section-{{ section.id }} .zh-newsletter--light .zh-nl-success,
  #shopify-section-{{ section.id }} .zh-newsletter--gold .zh-nl-success {
    color: #1a1a1a;
    background: rgba(0,0,0,0.06);
    border-color: rgba(0,0,0,0.12);
  }

  /* RTL */
  [dir="rtl"] #shopify-section-{{ section.id }} .zh-nl-row {
    flex-direction: row-reverse;
  }

  [dir="rtl"] #shopify-section-{{ section.id }} .zh-nl-gdpr-label {
    flex-direction: row-reverse;
  }

  /* Mobile */
  @media (max-width: 639px) {
    #shopify-section-{{ section.id }} .zh-nl-row {
      flex-direction: column;
      border-radius: 6px;
      overflow: visible;
      box-shadow: none;
    }

    #shopify-section-{{ section.id }} .zh-nl-input {
      border-radius: 6px;
      box-shadow: 0 2px 12px rgba(0,0,0,0.12);
      margin-bottom: 8px;
    }

    #shopify-section-{{ section.id }} .zh-nl-btn {
      border-radius: 6px;
      width: 100%;
      box-shadow: 0 2px 12px rgba(0,0,0,0.12);
    }
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>

<script>
(function() {
  var url = window.location.search;
  if (url.indexOf('customer_posted=true') !== -1) {
    var successEl = document.querySelector('#shopify-section-{{ section.id }} .zh-nl-success');
    if (successEl) {
      successEl.style.display = 'flex';
    }
  }
})();
</script>

<script src="{{ 'zh-premium.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "class": "zh-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Join Our Community"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Subscribe & Save 10%"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Get exclusive offers, new arrival alerts, and interior design tips."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email Placeholder",
      "default": "Enter your email address"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Subscribe"
    },
    {
      "type": "textarea",
      "id": "disclaimer",
      "label": "Disclaimer Text",
      "default": "By subscribing you agree to our Privacy Policy. Unsubscribe anytime."
    },
    {
      "type": "checkbox",
      "id": "show_name_field",
      "label": "Show Name Field",
      "default": false
    },
    {
      "type": "text",
      "id": "name_placeholder",
      "label": "Name Placeholder",
      "default": "Your name"
    },
    {
      "type": "checkbox",
      "id": "show_gdpr",
      "label": "Show GDPR Checkbox",
      "default": false
    },
    {
      "type": "text",
      "id": "gdpr_text",
      "label": "GDPR Label",
      "default": "I agree to receive marketing emails"
    },
    {
      "type": "select",
      "id": "background_style",
      "label": "Background Style",
      "options": [
        { "value": "dark", "label": "Dark" },
        { "value": "gold", "label": "Gold" },
        { "value": "light", "label": "Light" },
        { "value": "image", "label": "Image" }
      ],
      "default": "dark"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#1A1A2E"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image (when style is Image)"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image Overlay Opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 50,
      "unit": "%"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success Message",
      "default": "Thank you for subscribing!"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 160,
      "step": 8,
      "default": 96,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "default": 96,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
