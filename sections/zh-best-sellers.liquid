{{ 'zh-premium.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign coll = collections[section.settings.collection]
  assign products_to_show = section.settings.products_to_show
-%}

<section
  id="zh-best-sellers-{{ section.id }}"
  class="zh-best-sellers"
  style="
    background-color: {{ section.settings.background_color }};
    --pt: {{ section.settings.padding_top }}px;
    --pb: {{ section.settings.padding_bottom }}px;
    --cols: {{ section.settings.columns }};
  "
>
  <div class="zh-container">

    {%- comment -%} Section header {%- endcomment -%}
    <div class="zh-section-header zh-anim">
      {%- if section.settings.eyebrow != blank -%}
        <p class="zh-section-header__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="zh-section-header__title">{{ section.settings.title }}</h2>
      {%- endif -%}
      <div class="zh-section-header__divider" aria-hidden="true">
        <span class="zh-section-header__divider-line"></span>
        <span class="zh-section-header__divider-diamond"></span>
        <span class="zh-section-header__divider-line"></span>
      </div>
      {%- if section.settings.subtitle != blank -%}
        <p class="zh-section-header__subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>

    {%- comment -%} Tabs (optional) {%- endcomment -%}
    {%- if section.settings.show_tabs and section.blocks.size > 0 -%}
      <div class="zh-tabs" data-zh-tabs role="tablist" aria-label="{{ section.settings.title | escape }}">
        {%- for block in section.blocks -%}
          <button
            class="zh-tabs__tab{% if forloop.index0 == 0 %} is-active{% endif %}"
            data-zh-tab="{{ forloop.index0 }}"
            data-collection="{{ block.settings.collection }}"
            role="tab"
            type="button"
            aria-selected="{% if forloop.index0 == 0 %}true{% else %}false{% endif %}"
            aria-controls="zh-bs-panel-{{ section.id }}-{{ forloop.index0 }}"
            id="zh-bs-tab-{{ section.id }}-{{ forloop.index0 }}"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.label | default: block.settings.collection }}
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%} Tab panels {%- endcomment -%}
    {%- if section.settings.show_tabs and section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {%- assign tab_coll = collections[block.settings.collection] -%}
        <div
          class="zh-best-sellers__panel{% if forloop.index0 == 0 %} is-active{% endif %}"
          id="zh-bs-panel-{{ section.id }}-{{ forloop.index0 }}"
          role="tabpanel"
          aria-labelledby="zh-bs-tab-{{ section.id }}-{{ forloop.index0 }}"
          data-zh-panel="{{ forloop.index0 }}"
        >
          {%- if tab_coll != blank and tab_coll.products.size > 0 -%}
            <div class="zh-product-grid" style="--cols: {{ section.settings.columns }};">
              {%- for product in tab_coll.products limit: products_to_show -%}
                <div class="zh-product-grid__item zh-anim" style="--anim-delay: {{ forloop.index0 | times: 60 }}ms;">
                  {%- render 'zh-product-card',
                    product: product,
                    show_quick_add: true,
                    show_wishlist: true,
                    show_rating: true
                  -%}
                </div>
              {%- endfor -%}
            </div>
          {%- else -%}
            <div class="zh-product-grid" style="--cols: {{ section.settings.columns }};">
              {%- for i in (1..4) -%}
                <div class="zh-product-grid__item zh-product-card zh-product-card--placeholder zh-anim" style="--anim-delay: {{ forloop.index0 | times: 60 }}ms;">
                  <div class="zh-product-card__image-wrap">
                    {{ 'product-' | append: i | placeholder_svg_tag: 'zh-product-card__placeholder-img' }}
                  </div>
                  <div class="zh-product-card__info">
                    <p class="zh-product-card__title">{{ 'onboarding.product_title' | t | default: 'Sample Product' }}</p>
                    <p class="zh-product-card__price">{{ 1990 | money }}</p>
                  </div>
                </div>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}

    {%- else -%}

      {%- comment -%} Default product grid (no tabs) {%- endcomment -%}
      {%- if coll != blank and coll.products.size > 0 -%}
        <div class="zh-product-grid">
          {%- for product in coll.products limit: products_to_show -%}
            <div class="zh-product-grid__item zh-anim" style="--anim-delay: {{ forloop.index0 | times: 60 }}ms;">
              {%- render 'zh-product-card',
                product: product,
                show_quick_add: true,
                show_wishlist: true,
                show_rating: true
              -%}
            </div>
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="zh-product-grid">
          {%- for i in (1..4) -%}
            <div class="zh-product-grid__item zh-product-card zh-product-card--placeholder zh-anim" style="--anim-delay: {{ forloop.index0 | times: 60 }}ms;">
              <div class="zh-product-card__image-wrap">
                {{ 'product-' | append: i | placeholder_svg_tag: 'zh-product-card__placeholder-img' }}
              </div>
              <div class="zh-product-card__info">
                <p class="zh-product-card__title">{{ 'onboarding.product_title' | t | default: 'Sample Product' }}</p>
                <p class="zh-product-card__price">{{ 1990 | money }}</p>
              </div>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

    {%- endif -%}

    {%- comment -%} View All link {%- endcomment -%}
    {%- if section.settings.show_view_all and section.settings.view_all_text != blank -%}
      <div class="zh-best-sellers__view-all zh-anim">
        <a
          href="{{ section.settings.view_all_url | default: coll.url | default: '#' }}"
          class="zh-btn-view-all"
        >
          {{ section.settings.view_all_text }}
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    {%- endif -%}

  </div>
</section>

<style>
  #zh-best-sellers-{{ section.id }} {
    padding-top: var(--pt, 60px);
    padding-bottom: var(--pb, 60px);
  }

  #zh-best-sellers-{{ section.id }} .zh-container {
    max-width: 1280px;
    margin: 0 auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }

  /* Section header */
  #zh-best-sellers-{{ section.id }} .zh-section-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  #zh-best-sellers-{{ section.id }} .zh-section-header__eyebrow {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: #C9A84C;
    margin: 0 0 0.6rem;
  }

  #zh-best-sellers-{{ section.id }} .zh-section-header__title {
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    font-weight: 700;
    color: #1A1A2E;
    margin: 0 0 1rem;
    line-height: 1.15;
  }

  #zh-best-sellers-{{ section.id }} .zh-section-header__divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    margin-bottom: 1rem;
  }

  #zh-best-sellers-{{ section.id }} .zh-section-header__divider-line {
    display: block;
    width: 60px;
    height: 1px;
    background: #C9A84C;
    opacity: 0.5;
  }

  #zh-best-sellers-{{ section.id }} .zh-section-header__divider-diamond {
    display: block;
    width: 6px;
    height: 6px;
    background: #C9A84C;
    transform: rotate(45deg);
  }

  #zh-best-sellers-{{ section.id }} .zh-section-header__subtitle {
    font-size: 1rem;
    color: #555;
    max-width: 560px;
    margin: 0 auto;
    line-height: 1.7;
  }

  /* Tabs */
  #zh-best-sellers-{{ section.id }} .zh-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
    margin-bottom: 2rem;
    border-bottom: 2px solid #e8e8e0;
    padding-bottom: 0;
  }

  #zh-best-sellers-{{ section.id }} .zh-tabs__tab {
    font-size: 0.85rem;
    font-weight: 600;
    color: #666;
    background: none;
    border: none;
    padding: 0.6rem 1.2rem;
    cursor: pointer;
    position: relative;
    transition: color 0.2s;
    letter-spacing: 0.04em;
    margin-bottom: -2px;
    border-bottom: 2px solid transparent;
  }

  #zh-best-sellers-{{ section.id }} .zh-tabs__tab:hover {
    color: #1A1A2E;
  }

  #zh-best-sellers-{{ section.id }} .zh-tabs__tab.is-active {
    color: #C9A84C;
    border-bottom-color: #C9A84C;
  }

  /* Tab panels */
  #zh-best-sellers-{{ section.id }} .zh-best-sellers__panel {
    display: none;
  }

  #zh-best-sellers-{{ section.id }} .zh-best-sellers__panel.is-active {
    display: block;
  }

  /* Product grid */
  #zh-best-sellers-{{ section.id }} .zh-product-grid {
    display: grid;
    grid-template-columns: repeat(var(--cols, 4), 1fr);
    gap: 1.5rem;
  }

  /* Placeholder cards */
  #zh-best-sellers-{{ section.id }} .zh-product-card--placeholder .zh-product-card__image-wrap {
    aspect-ratio: 3 / 4;
    background: #f0ede8;
    border-radius: 4px;
    overflow: hidden;
  }

  #zh-best-sellers-{{ section.id }} .zh-product-card--placeholder .zh-product-card__placeholder-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #zh-best-sellers-{{ section.id }} .zh-product-card--placeholder .zh-product-card__info {
    padding: 0.75rem 0;
  }

  #zh-best-sellers-{{ section.id }} .zh-product-card--placeholder .zh-product-card__title {
    font-size: 0.9rem;
    font-weight: 600;
    color: #1A1A2E;
    margin: 0 0 0.25rem;
  }

  #zh-best-sellers-{{ section.id }} .zh-product-card--placeholder .zh-product-card__price {
    font-size: 0.85rem;
    color: #C9A84C;
    font-weight: 500;
    margin: 0;
  }

  /* View All */
  #zh-best-sellers-{{ section.id }} .zh-best-sellers__view-all {
    text-align: center;
    margin-top: 2.5rem;
  }

  #zh-best-sellers-{{ section.id }} .zh-btn-view-all {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #1A1A2E;
    text-decoration: none;
    border-bottom: 2px solid #C9A84C;
    padding-bottom: 0.2rem;
    transition: color 0.2s, gap 0.2s;
  }

  #zh-best-sellers-{{ section.id }} .zh-btn-view-all:hover {
    color: #C9A84C;
    gap: 0.75rem;
  }

  /* Scroll animation */
  #zh-best-sellers-{{ section.id }} .zh-anim {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.55s ease, transform 0.55s ease;
    transition-delay: var(--anim-delay, 0ms);
  }

  #zh-best-sellers-{{ section.id }} .zh-anim.zh-anim--visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 1023px) {
    #zh-best-sellers-{{ section.id }} .zh-product-grid {
      grid-template-columns: repeat(
        {{ section.settings.columns | minus: 1 | at_least: 2 }},
        1fr
      );
    }
  }

  @media (max-width: 767px) {
    #zh-best-sellers-{{ section.id }} .zh-product-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.75rem;
    }
  }
</style>

<script src="{{ 'zh-premium.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "ZH Best Sellers",
  "tag": "section",
  "class": "zh-section-best-sellers",
  "max_blocks": 5,
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Best Sellers"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle"
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Source Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to Show",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (Desktop)",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Tabs"
    },
    {
      "type": "checkbox",
      "id": "show_tabs",
      "label": "Show Category Tabs",
      "default": false,
      "info": "Add tab blocks below to enable tabs"
    },
    {
      "type": "header",
      "content": "View All"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View All Button",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View All Button Text",
      "default": "View All Best Sellers"
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "View All URL (optional, defaults to collection URL)"
    },
    {
      "type": "header",
      "content": "Colors & Spacing"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Tab Label",
          "default": "Category"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ZH Best Sellers"
    }
  ]
}
{% endschema %}
