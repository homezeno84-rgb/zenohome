{{ 'zh-premium.css' | asset_url | stylesheet_tag }}
<script src="{{ 'zh-premium.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign layout = section.settings.layout | default: 'featured-left'
  assign col = section.settings.collection
  assign limit = section.settings.products_to_show | default: 4
  assign feat_prod = section.settings.featured_product
  assign pt = section.settings.padding_top | default: 64
  assign pb = section.settings.padding_bottom | default: 64
  assign bg = section.settings.background | default: '#ffffff'
-%}

<section
  class="zh-section zh-zeno-picks"
  id="zh-zeno-picks-{{ section.id }}"
  style="padding-top:{{ pt }}px;padding-bottom:{{ pb }}px;background:{{ bg }};"
>
  <div class="zh-container">
    <header class="zh-section-header zh-anim">
      {%- if section.settings.eyebrow != blank -%}
        <span class="zh-section-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2 class="zh-section-title">{{ section.settings.title | default: 'Zeno Picks' }}</h2>
      {%- if section.settings.subtitle != blank -%}
        <p class="zh-section-subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
      <span class="zh-section-divider"></span>
    </header>

    {%- if layout == 'grid' -%}
      <div class="zh-product-grid" style="--cols:4;--cols-mobile:2;">
        {%- if col != blank -%}
          {%- for product in col.products limit: limit -%}
            {%- render 'zh-product-card', product: product, show_quick_add: true, show_wishlist: true, show_rating: true, card_index: forloop.index -%}
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..4) -%}
            <div class="zh-pc zh-anim"><div class="zh-pc__media">{{ 'product-1' | placeholder_svg_tag: 'zh-pc__placeholder-img' }}</div><div class="zh-pc__info"><p class="zh-pc__title">Zeno Pick</p></div></div>
          {%- endfor -%}
        {%- endif -%}
      </div>

    {%- else -%}
      {%- assign is_right = false -%}
      {%- if layout == 'featured-right' -%}{%- assign is_right = true -%}{%- endif -%}
      <div class="zh-zeno-picks__layout zh-zeno-picks__layout--{{ layout }}">

        {%- unless is_right -%}
        <div class="zh-zeno-picks__featured zh-anim">
          {%- if feat_prod != blank -%}
            <a href="{{ feat_prod.url }}" class="zh-zeno-picks__feat-link">
              {%- if feat_prod.featured_media != blank -%}
                {{ feat_prod.featured_media | image_url: width: 800 | image_tag: class: 'zh-zeno-picks__feat-img', loading: 'lazy', widths: '400,600,800', alt: feat_prod.title | escape }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'zh-zeno-picks__feat-img zh-zeno-picks__feat-placeholder' }}
              {%- endif -%}
            </a>
            <div class="zh-zeno-picks__feat-info">
              {%- if feat_prod.vendor != blank -%}<span class="zh-pc__vendor">{{ feat_prod.vendor }}</span>{%- endif -%}
              <h3 class="zh-zeno-picks__feat-title"><a href="{{ feat_prod.url }}">{{ feat_prod.title }}</a></h3>
              <div class="zh-pc__price">
                {%- if feat_prod.compare_at_price > feat_prod.price -%}
                  <span class="zh-pc__price-sale">{{ feat_prod.price | money }}</span>
                  <s class="zh-pc__price-compare">{{ feat_prod.compare_at_price | money }}</s>
                {%- else -%}
                  <span class="zh-pc__price-regular">{{ feat_prod.price | money }}</span>
                {%- endif -%}
              </div>
              {%- if feat_prod.description != blank -%}
                <p class="zh-zeno-picks__feat-desc">{{ feat_prod.description | strip_html | truncate: 150 }}</p>
              {%- endif -%}
              <a href="{{ feat_prod.url }}" class="zh-btn zh-btn--gold">{{ 'products.product.shop_now' | t | default: 'Shop Now' }}</a>
            </div>
          {%- else -%}
            <div class="zh-zeno-picks__feat-placeholder">
              {{ 'product-1' | placeholder_svg_tag: 'zh-zeno-picks__feat-img' }}
              <div class="zh-zeno-picks__feat-info">
                <h3 class="zh-zeno-picks__feat-title">Featured Product</h3>
                <p class="zh-zeno-picks__feat-desc">Select a featured product in the Theme Editor.</p>
              </div>
            </div>
          {%- endif -%}
        </div>
        {%- endunless -%}

        <div class="zh-zeno-picks__grid">
          {%- if col != blank -%}
            {%- for product in col.products limit: limit -%}
              {%- render 'zh-product-card', product: product, show_quick_add: true, show_wishlist: true, show_rating: true, card_index: forloop.index -%}
            {%- else -%}
              {%- for i in (1..4) -%}
                <div class="zh-pc zh-anim"><div class="zh-pc__media">{{ 'product-2' | placeholder_svg_tag: 'zh-pc__placeholder-img' }}</div><div class="zh-pc__info"><p class="zh-pc__title">Zeno Pick</p></div></div>
              {%- endfor -%}
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..4) -%}
              <div class="zh-pc zh-anim"><div class="zh-pc__media">{{ 'product-3' | placeholder_svg_tag: 'zh-pc__placeholder-img' }}</div><div class="zh-pc__info"><p class="zh-pc__title">Zeno Pick {{ i }}</p></div></div>
            {%- endfor -%}
          {%- endif -%}
        </div>

        {%- if is_right -%}
        <div class="zh-zeno-picks__featured zh-anim">
          {%- if feat_prod != blank -%}
            <a href="{{ feat_prod.url }}" class="zh-zeno-picks__feat-link">
              {%- if feat_prod.featured_media != blank -%}
                {{ feat_prod.featured_media | image_url: width: 800 | image_tag: class: 'zh-zeno-picks__feat-img', loading: 'lazy', alt: feat_prod.title | escape }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'zh-zeno-picks__feat-img' }}
              {%- endif -%}
            </a>
            <div class="zh-zeno-picks__feat-info">
              <h3 class="zh-zeno-picks__feat-title"><a href="{{ feat_prod.url }}">{{ feat_prod.title }}</a></h3>
              <div class="zh-pc__price">
                {%- if feat_prod.compare_at_price > feat_prod.price -%}
                  <span class="zh-pc__price-sale">{{ feat_prod.price | money }}</span>
                  <s class="zh-pc__price-compare">{{ feat_prod.compare_at_price | money }}</s>
                {%- else -%}
                  <span class="zh-pc__price-regular">{{ feat_prod.price | money }}</span>
                {%- endif -%}
              </div>
              {%- if feat_prod.description != blank -%}
                <p class="zh-zeno-picks__feat-desc">{{ feat_prod.description | strip_html | truncate: 150 }}</p>
              {%- endif -%}
              <a href="{{ feat_prod.url }}" class="zh-btn zh-btn--gold">{{ 'products.product.shop_now' | t | default: 'Shop Now' }}</a>
            </div>
          {%- endif -%}
        </div>
        {%- endif -%}

      </div>
    {%- endif -%}

    {%- if section.settings.show_view_all and section.settings.view_all_url != blank -%}
      <div class="zh-section-footer zh-anim">
        <a href="{{ section.settings.view_all_url }}" class="zh-btn zh-btn--outline-dark">
          {{ section.settings.view_all_text | default: 'View All Picks' }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Zeno Picks",
  "tag": "section",
  "class": "zh-zeno-picks-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Curated for You" },
    { "type": "text", "id": "title", "label": "Title", "default": "Zeno Picks" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "Handpicked by our design experts" },
    { "type": "select", "id": "layout", "label": "Layout", "options": [
        { "value": "featured-left", "label": "Featured left" },
        { "value": "featured-right", "label": "Featured right" },
        { "value": "grid", "label": "Grid only" }
      ], "default": "featured-left" },
    { "type": "product", "id": "featured_product", "label": "Featured product" },
    { "type": "collection", "id": "collection", "label": "Products collection" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 8, "step": 1, "default": 4, "label": "Products to show" },
    { "type": "checkbox", "id": "show_view_all", "label": "Show view all", "default": false },
    { "type": "text", "id": "view_all_text", "label": "View all text", "default": "View All Picks" },
    { "type": "url", "id": "view_all_url", "label": "View all URL" },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 8, "default": 64, "label": "Padding top", "unit": "px" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 8, "default": 64, "label": "Padding bottom", "unit": "px" }
  ],
  "presets": [{ "name": "Zeno Picks" }]
}
{% endschema %}
