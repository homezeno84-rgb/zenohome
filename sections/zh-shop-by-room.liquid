{% comment %}
  ZenoHome – Shop by Room
  Section: zh-shop-by-room.liquid
  Supports RTL (Arabic) and LTR (English)
{% endcomment %}

{{ 'zh-premium.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign section_dir = 'ltr'
  if request.locale.iso_code == 'ar'
    assign section_dir = 'rtl'
  endif
-%}

<section
  id="zh-shop-by-room-{{ section.id }}"
  class="zh-shop-by-room zh-section"
  dir="{{ section_dir }}"
  style="
    --zh-sbr-bg: {{ section.settings.background_color }};
    --zh-sbr-pt: {{ section.settings.padding_top }}px;
    --zh-sbr-pb: {{ section.settings.padding_bottom }}px;
    --zh-sbr-columns: {{ section.settings.columns }};
  "
>
  <div class="zh-container">

    {%- if section.settings.eyebrow != blank or section.settings.title != blank or section.settings.subtitle != blank -%}
      <div class="zh-section-header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="zh-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class="zh-section-title">{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="zh-section-subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="zh-room-grid zh-room-grid--{{ section.settings.layout }}">
        {%- for block in section.blocks -%}
          {%- liquid
            assign overlay_opacity = block.settings.overlay_opacity | divided_by: 100.0
            assign card_class = 'zh-room-card'
            if block.settings.featured
              assign card_class = 'zh-room-card zh-room-card--featured'
            endif
          -%}
          <div
            class="{{ card_class }}"
            {{ block.shopify_attributes }}
            style="--zh-card-text-color: {{ block.settings.text_color }};"
          >
            <a
              class="zh-room-card__link"
              {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %}
              aria-label="{{ block.settings.title | escape }}"
            >
              <div class="zh-room-card__media">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 1200
                    | image_tag:
                      loading: 'lazy',
                      class: 'zh-room-card__image',
                      alt: block.settings.image.alt | default: block.settings.title | escape,
                      widths: '400, 600, 800, 1000, 1200'
                  }}
                {%- else -%}
                  <div class="zh-room-card__placeholder">
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'zh-placeholder-svg' }}
                  </div>
                {%- endif -%}

                <div
                  class="zh-room-card__overlay"
                  style="background: linear-gradient(to top, rgba(0,0,0,{{ overlay_opacity }}) 0%, rgba(0,0,0,0) 60%);"
                ></div>
              </div>

              <div class="zh-room-card__content">
                {%- if block.settings.badge != blank -%}
                  <span class="zh-room-card__badge">{{ block.settings.badge }}</span>
                {%- endif -%}
                <div class="zh-room-card__text">
                  <div class="zh-room-card__text-inner">
                    {%- if block.settings.title != blank -%}
                      <h3 class="zh-room-card__title">{{ block.settings.title }}</h3>
                    {%- endif -%}
                    {%- if block.settings.subtitle != blank -%}
                      <p class="zh-room-card__subtitle">{{ block.settings.subtitle }}</p>
                    {%- endif -%}
                  </div>
                  <span class="zh-room-card__arrow" aria-hidden="true">
                    {%- if section_dir == 'rtl' -%}
                      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12.5 5L7.5 10L12.5 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    {%- else -%}
                      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M7.5 5L12.5 10L7.5 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    {%- endif -%}
                  </span>
                </div>
              </div>
            </a>
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="zh-empty-state">
        <p>Add room cards in the theme editor to get started.</p>
      </div>
    {%- endif -%}

  </div>
</section>

<style>
  #zh-shop-by-room-{{ section.id }} {
    background-color: var(--zh-sbr-bg, #FFFFFF);
    padding-top: var(--zh-sbr-pt, 60px);
    padding-bottom: var(--zh-sbr-pb, 60px);
  }

  #zh-shop-by-room-{{ section.id }} .zh-container {
    max-width: 1400px;
    margin: 0 auto;
    padding-inline: clamp(16px, 4vw, 64px);
  }

  #zh-shop-by-room-{{ section.id }} .zh-section-header {
    text-align: center;
    margin-bottom: 48px;
  }

  #zh-shop-by-room-{{ section.id }} .zh-eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #C9A84C;
    margin: 0 0 12px;
  }

  #zh-shop-by-room-{{ section.id }} .zh-section-title {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 300;
    letter-spacing: -0.02em;
    margin: 0 0 16px;
    color: #1A1A1A;
  }

  #zh-shop-by-room-{{ section.id }} .zh-section-subtitle {
    font-size: 1rem;
    color: #666;
    margin: 0;
    max-width: 560px;
    margin-inline: auto;
    line-height: 1.6;
  }

  #zh-shop-by-room-{{ section.id }} .zh-room-grid {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(var(--zh-sbr-columns, 3), 1fr);
  }

  #zh-shop-by-room-{{ section.id }} .zh-room-grid--large-small .zh-room-card--featured {
    grid-column: span 2;
  }

  #zh-shop-by-room-{{ section.id }} .zh-room-grid--masonry {
    align-items: start;
  }

  #zh-shop-by-room-{{ section.id }} .zh-room-card {
    border-radius: 8px;
    overflow: hidden;
    position: relative;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  #zh-shop-by-room-{{ section.id }} .zh-room-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.15);
  }

  #zh-shop-by-room-{{ section.id }} .zh-room-card__link {
    display: block;
    position: relative;
    text-decoration: none;
    height: 100%;
  }

  #zh-shop-by-room-{{ section.id }} .zh-room-card__media {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
  }

  #zh-shop-by-room-{{ section.id }} .zh-room-card--featured .zh-room-card__media {
    aspect-ratio: 16 / 9;
  }

  #zh-shop-by-room-{{ section.id }} .zh-room-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    display: block;
  }

  #zh-shop-by-room-{{ section.id }} .zh-room-card:hover .zh-room-card__image {
    transform: scale(1.06);
  }

  #zh-shop-by-room-{{ section.id }} .zh-room-card__placeholder {
    width: 100%;
    height: 100%;
    background: #F0EBE1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #zh-shop-by-room-{{ section.id }} .zh-placeholder-svg {
    width: 100%;
    height: 100%;
    opacity: 0.35;
  }

  #zh-shop-by-room-{{ section.id }} .zh-room-card__overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  #zh-shop-by-room-{{ section.id }} .zh-room-card__content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 24px;
    color: var(--zh-card-text-color, #ffffff);
  }

  #zh-shop-by-room-{{ section.id }} .zh-room-card__badge {
    position: absolute;
    top: 16px;
    inset-inline-start: 16px;
    background: rgba(201, 168, 76, 0.92);
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 3px;
  }

  #zh-shop-by-room-{{ section.id }} .zh-room-card__text {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
    transform: translateY(4px);
    transition: transform 0.35s ease;
  }

  #zh-shop-by-room-{{ section.id }} .zh-room-card:hover .zh-room-card__text {
    transform: translateY(0);
  }

  #zh-shop-by-room-{{ section.id }} .zh-room-card__title {
    margin: 0 0 4px;
    font-size: 1.2rem;
    font-weight: 500;
    line-height: 1.2;
    color: inherit;
  }

  #zh-shop-by-room-{{ section.id }} .zh-room-card__subtitle {
    margin: 0;
    font-size: 0.8125rem;
    opacity: 0.8;
    color: inherit;
    line-height: 1.4;
  }

  #zh-shop-by-room-{{ section.id }} .zh-room-card__arrow {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border: 1.5px solid rgba(255, 255, 255, 0.55);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.3s ease, border-color 0.3s ease, transform 0.3s ease;
  }

  #zh-shop-by-room-{{ section.id }} .zh-room-card:hover .zh-room-card__arrow {
    background: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.9);
    transform: scale(1.08);
  }

  #zh-shop-by-room-{{ section.id }} .zh-empty-state {
    text-align: center;
    padding: 60px 20px;
    color: #999;
    border: 2px dashed #ddd;
    border-radius: 8px;
  }

  @media (max-width: 900px) {
    #zh-shop-by-room-{{ section.id }} .zh-room-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    #zh-shop-by-room-{{ section.id }} .zh-room-grid--large-small .zh-room-card--featured {
      grid-column: span 2;
    }
  }

  @media (max-width: 540px) {
    #zh-shop-by-room-{{ section.id }} .zh-room-grid {
      grid-template-columns: 1fr;
    }

    #zh-shop-by-room-{{ section.id }} .zh-room-grid--large-small .zh-room-card--featured {
      grid-column: span 1;
    }

    #zh-shop-by-room-{{ section.id }} .zh-room-card__media {
      aspect-ratio: 4 / 3;
    }
  }
</style>

<script src="{{ 'zh-premium.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Shop by Room",
  "tag": "section",
  "class": "zh-section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Explore"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Shop by Room"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Grid Layout",
      "options": [
        { "value": "grid", "label": "Uniform Grid" },
        { "value": "masonry", "label": "Masonry" },
        { "value": "large-small", "label": "Large + Small (Featured)" }
      ],
      "default": "large-small"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "room",
      "name": "Room Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Room Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Room Name",
          "default": "Living Room"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Short Description"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge Text"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "Overlay Opacity",
          "min": 0,
          "max": 70,
          "step": 5,
          "unit": "%",
          "default": 30
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text Color",
          "default": "#ffffff"
        },
        {
          "type": "checkbox",
          "id": "featured",
          "label": "Featured (spans 2 columns)",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Shop by Room",
      "blocks": [
        { "type": "room", "settings": { "title": "Living Room", "featured": true } },
        { "type": "room", "settings": { "title": "Bedroom" } },
        { "type": "room", "settings": { "title": "Dining Room" } },
        { "type": "room", "settings": { "title": "Home Office" } },
        { "type": "room", "settings": { "title": "Outdoor" } }
      ]
    }
  ]
}
{% endschema %}
