{{ 'zh-sections.css' | asset_url | stylesheet_tag }}
{{ 'zh-sections.js' | asset_url | script_tag }}

{%- liquid
  assign pt = section.settings.padding_top | default: 80
  assign pb = section.settings.padding_bottom | default: 80
  assign layout = section.settings.layout | default: 'carousel'
-%}

<section
  class="zh-section zh-testimonials-section"
  id="zh-testimonials-{{ section.id }}"
  style="padding-top: {{ pt }}px; padding-bottom: {{ pb }}px; background: {{ section.settings.background_color | default: '#FAFAF8' }};"
>
  <div class="zh-container">
    {%- if section.settings.title != blank -%}
      <header class="zh-section-header zh-anim">
        {%- if section.settings.eyebrow != blank -%}<span class="zh-section-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2 class="zh-section-title">{{ section.settings.title }}</h2>
        {%- if section.settings.subtitle != blank -%}<p class="zh-section-subtitle">{{ section.settings.subtitle }}</p>{%- endif -%}
        <span class="zh-section-divider"></span>
      </header>
    {%- endif -%}

    <div class="zh-testimonials-wrap zh-testimonials--{{ layout }}" id="tcarousel-{{ section.id }}">
      <div class="zh-testimonials-track">
        {%- for block in section.blocks -%}
          <div class="zh-testimonial-card{% if layout != 'carousel' %} zh-anim zh-anim-delay-{{ forloop.index | modulo: 3 | plus: 1 }}{% endif %}" {{ block.shopify_attributes }}>
            <div class="zh-t-stars">
              {%- for i in (1..5) -%}
                <span class="zh-t-star{% if i <= block.settings.rating %} active{% endif %}"></span>
              {%- endfor -%}
            </div>
            {%- if block.settings.text != blank -%}
              <p class="zh-t-text">&ldquo;{{ block.settings.text }}&rdquo;</p>
            {%- endif -%}
            <div class="zh-t-author">
              {%- if block.settings.avatar != blank -%}
                {{ block.settings.avatar | image_url: width: 96 | image_tag: class: 'zh-t-avatar', loading: 'lazy', alt: block.settings.name }}
              {%- else -%}
                <div class="zh-t-avatar-placeholder">{{ block.settings.name | slice: 0 }}</div>
              {%- endif -%}
              <div>
                {%- if block.settings.name != blank -%}<div class="zh-t-name">{{ block.settings.name }}</div>{%- endif -%}
                {%- if block.settings.location != blank -%}<div class="zh-t-location">{{ block.settings.location }}</div>{%- endif -%}
                {%- if block.settings.product != blank -%}<div class="zh-t-product">{{ block.settings.product }}</div>{%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
      {%- if layout == 'carousel' and section.blocks.size > 1 -%}
        <div class="zh-testimonials-nav">
          <button class="zh-slider-arrow zh-t-prev" aria-label="Previous">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          <div class="zh-t-dots">
            {%- for block in section.blocks -%}
              <button class="zh-slider-dot{% if forloop.first %} active{% endif %}" aria-label="Slide {{ forloop.index }}"></button>
            {%- endfor -%}
          </div>
          <button class="zh-slider-arrow zh-t-next" aria-label="Next">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  #zh-testimonials-{{ section.id }} .zh-testimonials-wrap { position: relative; }
  #zh-testimonials-{{ section.id }} .zh-testimonials--grid .zh-testimonials-track {
    display: grid; grid-template-columns: repeat(3,1fr); gap: 24px;
  }
  #zh-testimonials-{{ section.id }} .zh-testimonials--masonry .zh-testimonials-track {
    columns: 3; column-gap: 24px;
  }
  #zh-testimonials-{{ section.id }} .zh-testimonials--carousel { overflow: hidden; }
  #zh-testimonials-{{ section.id }} .zh-testimonials--carousel .zh-testimonials-track {
    display: flex; transition: transform .55s cubic-bezier(.22,1,.36,1);
  }
  #zh-testimonials-{{ section.id }} .zh-testimonials--carousel .zh-testimonial-card {
    flex: 0 0 calc(33.333% - 16px); margin-inline-end: 24px;
  }
  #zh-testimonials-{{ section.id }} .zh-testimonial-card {
    background: #fff; border-radius: 12px; padding: 32px;
    box-shadow: 0 4px 16px rgba(0,0,0,.07); position: relative;
    break-inside: avoid; margin-bottom: 24px;
  }
  #zh-testimonials-{{ section.id }} .zh-t-stars { display: flex; gap: 3px; margin-bottom: 16px; }
  #zh-testimonials-{{ section.id }} .zh-t-star {
    width:14px;height:14px;
    clip-path: polygon(50% 0%,61% 35%,98% 35%,68% 57%,79% 91%,50% 70%,21% 91%,32% 57%,2% 35%,39% 35%);
    background: #e8e8e8;
  }
  #zh-testimonials-{{ section.id }} .zh-t-star.active { background: var(--zh-gold,#C9A84C); }
  #zh-testimonials-{{ section.id }} .zh-t-text {
    font-size:.95rem;line-height:1.75;color:var(--zh-text,#222);
    margin-bottom:24px;font-style:italic;
  }
  [dir="rtl"] #zh-testimonials-{{ section.id }} .zh-t-text { font-family:var(--zh-font-ar,'Cairo',sans-serif);font-style:normal; }
  #zh-testimonials-{{ section.id }} .zh-t-author { display:flex;align-items:center;gap:14px; }
  #zh-testimonials-{{ section.id }} .zh-t-avatar { width:48px;height:48px;border-radius:50%;object-fit:cover;border:2px solid var(--zh-gold-xlight,#F5EDD4); }
  #zh-testimonials-{{ section.id }} .zh-t-avatar-placeholder {
    width:48px;height:48px;border-radius:50%;
    background:var(--zh-gold-xlight,#F5EDD4);
    display:flex;align-items:center;justify-content:center;
    font-family:var(--zh-font-display,serif);font-size:1.25rem;font-weight:700;
    color:var(--zh-gold-dark,#A07830);
  }
  #zh-testimonials-{{ section.id }} .zh-t-name { font-weight:700;font-size:.9rem;color:var(--zh-dark,#1A1A2E);margin-bottom:2px; }
  #zh-testimonials-{{ section.id }} .zh-t-location { font-size:.75rem;color:var(--zh-text-muted,#888); }
  #zh-testimonials-{{ section.id }} .zh-t-product { font-size:.72rem;color:var(--zh-gold,#C9A84C);font-weight:600;letter-spacing:.08em; }
  #zh-testimonials-{{ section.id }} .zh-testimonials-nav {
    display:flex;align-items:center;justify-content:center;gap:20px;margin-top:32px;
  }
  #zh-testimonials-{{ section.id }} .zh-slider-arrow {
    width:44px;height:44px;display:flex;align-items:center;justify-content:center;
    background:#fff;border:1px solid var(--zh-border,#e8e8e8);border-radius:50%;
    color:var(--zh-dark,#1A1A2E);cursor:pointer;
    transition:background .25s,border-color .25s,color .25s;
  }
  #zh-testimonials-{{ section.id }} .zh-slider-arrow:hover { background:var(--zh-gold,#C9A84C);border-color:var(--zh-gold,#C9A84C);color:#fff; }
  #zh-testimonials-{{ section.id }} .zh-t-dots { display:flex;gap:8px; }
  #zh-testimonials-{{ section.id }} .zh-slider-dot {
    width:8px;height:8px;border-radius:50%;background:var(--zh-border,#e8e8e8);
    border:none;cursor:pointer;padding:0;transition:background .25s,transform .25s;
  }
  #zh-testimonials-{{ section.id }} .zh-slider-dot.active { background:var(--zh-gold,#C9A84C);transform:scale(1.4); }
  @media(max-width:1024px){
    #zh-testimonials-{{ section.id }} .zh-testimonials--grid .zh-testimonials-track { grid-template-columns:repeat(2,1fr); }
    #zh-testimonials-{{ section.id }} .zh-testimonials--masonry .zh-testimonials-track { columns:2; }
    #zh-testimonials-{{ section.id }} .zh-testimonials--carousel .zh-testimonial-card { flex:0 0 calc(50% - 12px); }
  }
  @media(max-width:640px){
    #zh-testimonials-{{ section.id }} .zh-testimonials--grid .zh-testimonials-track { grid-template-columns:1fr; }
    #zh-testimonials-{{ section.id }} .zh-testimonials--masonry .zh-testimonials-track { columns:1; }
    #zh-testimonials-{{ section.id }} .zh-testimonials--carousel .zh-testimonial-card { flex:0 0 100%;margin-inline-end:0; }
  }
</style>

<script>
(function(){
  var wrap = document.getElementById('tcarousel-{{ section.id }}');
  if(!wrap || !wrap.classList.contains('zh-testimonials--carousel')) return;
  var track = wrap.querySelector('.zh-testimonials-track');
  var dots = wrap.querySelectorAll('.zh-slider-dot');
  var prev = wrap.querySelector('.zh-t-prev');
  var next = wrap.querySelector('.zh-t-next');
  var cards = track.querySelectorAll('.zh-testimonial-card');
  var total = cards.length;
  var cur = 0;
  function perView(){ return window.innerWidth < 640 ? 1 : window.innerWidth < 1024 ? 2 : 3; }
  function goTo(idx){
    var pv = perView();
    cur = Math.max(0,Math.min(idx,total-pv));
    var cw = cards[0] ? cards[0].offsetWidth + 24 : 0;
    track.style.transform = 'translateX(-'+(cur*cw)+'px)';
    dots.forEach(function(d,i){ d.classList.toggle('active',i===cur); });
  }
  if(prev) prev.addEventListener('click',function(){ goTo(cur-1); });
  if(next) next.addEventListener('click',function(){ goTo(cur+1); });
  dots.forEach(function(d,i){ d.addEventListener('click',function(){ goTo(i); }); });
  {% if section.settings.autoplay %}
  var t = setInterval(function(){
    var pv = perView();
    goTo(cur+1 > total-pv ? 0 : cur+1);
  }, {{ section.settings.autoplay_speed | default: 5 | times: 1000 }});
  wrap.addEventListener('mouseenter',function(){ clearInterval(t); });
  {% endif %}
})();
</script>

{% schema %}
{
  "name": "GCC Testimonials",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Customer Reviews" },
    { "type": "text", "id": "title", "label": "Title", "default": "What Our Customers Say" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle" },
    { "type": "select", "id": "layout", "label": "Layout", "options": [{ "value": "carousel", "label": "Carousel" }, { "value": "grid", "label": "Grid" }, { "value": "masonry", "label": "Masonry" }], "default": "carousel" },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay", "default": true },
    { "type": "range", "id": "autoplay_speed", "label": "Autoplay Speed (s)", "min": 3, "max": 10, "step": 1, "default": 5 },
    { "type": "color", "id": "background_color", "label": "Background Color", "default": "#FAFAF8" },
    { "type": "range", "id": "padding_top", "label": "Padding Top (px)", "min": 0, "max": 120, "step": 8, "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Padding Bottom (px)", "min": 0, "max": 120, "step": 8, "default": 80 }
  ],
  "blocks": [
    {
      "type": "review", "name": "Review",
      "settings": [
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "text", "label": "Review Text", "default": "Absolutely love the quality! The pieces transformed my living room completely." },
        { "type": "text", "id": "name", "label": "Reviewer Name", "default": "Sarah Al-Ahmed" },
        { "type": "text", "id": "location", "label": "Location", "default": "Riyadh, KSA" },
        { "type": "text", "id": "product", "label": "Product Purchased" },
        { "type": "image_picker", "id": "avatar", "label": "Reviewer Photo" }
      ]
    }
  ],
  "presets": [{
    "name": "GCC Testimonials",
    "blocks": [
      { "type": "review", "settings": { "rating": 5, "name": "Noura Al-Rashidi", "location": "Dubai, UAE", "text": "The quality exceeded my expectations. Premium materials and stunning design." } },
      { "type": "review", "settings": { "rating": 5, "name": "Mohammed Al-Saud", "location": "Riyadh, KSA", "text": "Fast delivery and impeccable packaging. Will order again!" } },
      { "type": "review", "settings": { "rating": 5, "name": "Fatima Hassan", "location": "Kuwait City", "text": "Beautiful pieces that perfectly complement GCC interior aesthetics." } }
    ]
  }]
}
{% endschema %}
