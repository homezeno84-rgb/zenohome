{% comment %} ZenoHome – Instagram Feed section {% endcomment %}

<link rel="stylesheet" href="{{ 'zh-premium.css' | asset_url }}">

{%- liquid
  assign dir = 'ltr'
  if request.locale.iso_code == 'ar'
    assign dir = 'rtl'
  endif
-%}

<section
  class="zh-instagram"
  data-zh-instagram
  dir="{{ dir }}"
  style="
    background-color: {{ section.settings.background }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="zh-container">

    {%- if section.settings.eyebrow != blank or section.settings.title != blank or section.settings.subtitle != blank -%}
      <div class="zh-section-header zh-section-header--center">
        {%- if section.settings.eyebrow != blank -%}
          <p class="zh-eyebrow">
            {%- if section.settings.instagram_url != blank -%}
              <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener" class="zh-ig-handle-link">{{ section.settings.eyebrow }}</a>
            {%- else -%}
              {{ section.settings.eyebrow }}
            {%- endif -%}
          </p>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class="zh-section-title">{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="zh-section-subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div
        class="zh-instagram-grid"
        style="
          --ig-columns: {{ section.settings.columns }};
          --ig-columns-mobile: {{ section.settings.columns_mobile }};
          --ig-gap: {{ section.settings.gap }}px;
        "
      >
        {%- for block in section.blocks -%}
          <div class="zh-ig-cell" {{ block.shopify_attributes }}>
            {%- if block.settings.url != blank -%}
              <a
                class="zh-ig-link"
                href="{{ block.settings.url }}"
                target="_blank"
                rel="noopener"
                aria-label="Instagram post{% if block.settings.caption != blank %}: {{ block.settings.caption | escape }}{% endif %}"
              >
            {%- else -%}
              <div class="zh-ig-link">
            {%- endif -%}

              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 600
                  | image_tag:
                    class: 'zh-ig-image',
                    alt: block.settings.caption | default: 'Instagram post',
                    loading: 'lazy',
                    widths: '300, 400, 600'
                }}
              {%- else -%}
                <div class="zh-ig-placeholder">
                  <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" ry="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
                </div>
              {%- endif -%}

              {%- if section.settings.show_hover_overlay -%}
                <div class="zh-ig-overlay" aria-hidden="true">
                  <svg class="zh-ig-icon" xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
                  {%- if block.settings.likes != blank -%}
                    <span class="zh-ig-likes">
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                      {{ block.settings.likes }}
                    </span>
                  {%- endif -%}
                </div>
              {%- endif -%}

            {%- if block.settings.url != blank -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.instagram_url != blank -%}
      <div class="zh-instagram-cta">
        <a
          href="{{ section.settings.instagram_url }}"
          target="_blank"
          rel="noopener"
          class="zh-btn zh-btn--outline"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          {% if dir == 'rtl' %}تابعنا على إنستغرام{% else %}Follow on Instagram{% endif %}
        </a>
      </div>
    {%- endif -%}

  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .zh-section-header--center {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 48px;
  }

  #shopify-section-{{ section.id }} .zh-eyebrow {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #C9A84C;
    margin-bottom: 12px;
    display: block;
  }

  #shopify-section-{{ section.id }} .zh-ig-handle-link {
    color: inherit;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  #shopify-section-{{ section.id }} .zh-ig-handle-link:hover {
    opacity: 0.75;
  }

  #shopify-section-{{ section.id }} .zh-section-title {
    font-size: clamp(24px, 3vw, 38px);
    font-weight: 700;
    line-height: 1.2;
    color: #1a1a1a;
    margin-bottom: 14px;
  }

  #shopify-section-{{ section.id }} .zh-section-subtitle {
    font-size: 16px;
    color: #666;
    line-height: 1.65;
  }

  #shopify-section-{{ section.id }} .zh-instagram-grid {
    display: grid;
    grid-template-columns: repeat(var(--ig-columns, 6), 1fr);
    gap: var(--ig-gap, 4px);
  }

  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .zh-instagram-grid {
      grid-template-columns: repeat(var(--ig-columns-mobile, 3), 1fr);
    }
  }

  #shopify-section-{{ section.id }} .zh-ig-cell {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    position: relative;
    background: #f0f0f0;
  }

  #shopify-section-{{ section.id }} .zh-ig-link {
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .zh-ig-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  #shopify-section-{{ section.id }} .zh-ig-link:hover .zh-ig-image {
    transform: scale(1.06);
  }

  #shopify-section-{{ section.id }} .zh-ig-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #e8e8e8;
    color: #bbb;
  }

  #shopify-section-{{ section.id }} .zh-ig-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.48);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    color: #fff;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  #shopify-section-{{ section.id }} .zh-ig-link:hover .zh-ig-overlay {
    opacity: 1;
  }

  #shopify-section-{{ section.id }} .zh-ig-icon {
    color: #fff;
    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.25));
  }

  #shopify-section-{{ section.id }} .zh-ig-likes {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 13px;
    font-weight: 600;
    color: #fff;
  }

  #shopify-section-{{ section.id }} .zh-instagram-cta {
    margin-top: 36px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .zh-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 13px 28px;
    font-size: 14px;
    font-weight: 600;
    border-radius: 4px;
    text-decoration: none;
    letter-spacing: 0.04em;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .zh-btn--outline {
    background: transparent;
    border: 2px solid #1a1a1a;
    color: #1a1a1a;
  }

  #shopify-section-{{ section.id }} .zh-btn--outline:hover {
    background: #1a1a1a;
    color: #fff;
  }
</style>

<script src="{{ 'zh-premium.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Instagram Feed",
  "tag": "section",
  "class": "zh-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Handle / Eyebrow",
      "default": "@zenohome.sa"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Follow Us on Instagram"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Tag us with #ZenoHome to be featured"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram Profile URL"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (Desktop)",
      "min": 3,
      "max": 8,
      "step": 1,
      "default": 6
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns (Mobile)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_hover_overlay",
      "label": "Show Hover Overlay",
      "default": true
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Grid Gap",
      "min": 2,
      "max": 16,
      "step": 2,
      "default": 4,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 72,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 72,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Instagram Post",
      "limit": 12,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Post Image"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Post URL"
        },
        {
          "type": "text",
          "id": "likes",
          "label": "Like Count (shown on hover)"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption (used as alt text)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Instagram Feed",
      "blocks": [
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" }
      ]
    }
  ]
}
{% endschema %}
