<!-- sections/gcc-faq.liquid -->
{%- liquid
  assign se_stts  = section.settings
  assign se_blocks = section.blocks
-%}

<section class="t4s-section-inner" data-gcc-reveal>
  <div class="t4s-container" style="max-width:760px;">

    {%- if se_stts.title != blank -%}
      <div style="text-align:center;margin-bottom:48px;">
        <h2 class="t4s-section__title" style="font-size:clamp(1.4rem,2.5vw,2rem);">{{ se_stts.title }}</h2>
        {%- if se_stts.subtitle != blank -%}
          <p style="color:var(--gcc-mid-gray,#9B9B9B);margin-top:12px;">{{ se_stts.subtitle }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="gcc-faq-list" data-gcc-reveal-stagger>
      {%- for block in se_blocks -%}
        {%- if block.type == 'faq' -%}
          <details class="gcc-faq__item" {{ block.shopify_attributes }}>
            <summary class="gcc-faq__question">
              {{ block.settings.question }}
              <svg class="gcc-faq__icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
              </svg>
            </summary>
            <div class="gcc-faq__answer">{{ block.settings.answer }}</div>
          </details>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "FAQ (GCC)",
  "tag": "section",
  "class": "gcc-section-faq",
  "settings": [
    { "type": "text",     "id": "title",    "label": "Title",    "default": "Frequently Asked Questions" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "" }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        { "type": "text",     "id": "question", "label": "Question", "default": "What is your return policy?" },
        { "type": "richtext", "id": "answer",   "label": "Answer",   "default": "<p>We offer a 30-day return policy on all items in original condition.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ (GCC)",
      "blocks": [
        { "type": "faq", "settings": { "question": "What is your return policy?",       "answer": "<p>We offer a 30-day return policy on all items in original condition.</p>" } },
        { "type": "faq", "settings": { "question": "Do you ship to all GCC countries?", "answer": "<p>Yes! We ship to Saudi Arabia, UAE, Kuwait, Qatar, Bahrain and Oman.</p>" } },
        { "type": "faq", "settings": { "question": "How long does delivery take?",      "answer": "<p>Standard delivery takes 2-5 business days across the GCC region.</p>" } },
        { "type": "faq", "settings": { "question": "What payment methods do you accept?","answer": "<p>We accept Mada, Visa, Mastercard, AMEX, Apple Pay, and Tabby installments.</p>" } }
      ]
    }
  ]
}
{% endschema %}
