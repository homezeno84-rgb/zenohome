<!-- sections/zh-why-us.liquid -->
{%- liquid
  assign se = section.settings
-%}

<section class="zh-why-us" data-gcc-reveal>
  <div class="t4s-container">
    <div class="zh-section-header">
      {%- if se.eyebrow != blank -%}
        <div class="zh-section-header__eyebrow">{{ se.eyebrow }}</div>
      {%- endif -%}
      <h2 class="zh-section-header__title">{{ se.title | default: 'Why Choose Zeno Home' }}</h2>
      <div class="zh-divider"></div>
      {%- if se.description != blank -%}
        <p class="zh-section-header__sub" style="margin-top:16px;">{{ se.description }}</p>
      {%- endif -%}
    </div>

    <div class="zh-why-us__grid">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <div class="zh-why-us__item" data-gcc-reveal data-delay="{{ forloop.index }}" {{ block.shopify_attributes }}>
          <div class="zh-why-us__icon-wrap">
            {%- case b.icon -%}
              {%- when 'quality' -%}
                <svg class="zh-why-us__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>
              {%- when 'delivery' -%}
                <svg class="zh-why-us__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 17H3a2 2 0 01-2-2V5a2 2 0 012-2h11a2 2 0 012 2v3m0 0h3l3 3v4h-6m0-7v7m0 0H9m6 0a2 2 0 11-4 0 2 2 0 014 0zm-6 0a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
              {%- when 'return' -%}
                <svg class="zh-why-us__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
              {%- when 'support' -%}
                <svg class="zh-why-us__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192L5.636 18.364M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
              {%- when 'secure' -%}
                <svg class="zh-why-us__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
              {%- else -%}
                <svg class="zh-why-us__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg>
            {%- endcase -%}
          </div>
          <h3 class="zh-why-us__title">{{ b.title }}</h3>
          {%- if b.description != blank -%}
            <p class="zh-why-us__desc">{{ b.description }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Why Choose Us",
  "tag": "section",
  "class": "zh-section-why-us",
  "settings": [
    { "type": "text",     "id": "eyebrow",     "label": "Eyebrow",      "default": "Our Promise" },
    { "type": "text",     "id": "title",       "label": "Title",        "default": "Why Choose Zeno Home" },
    { "type": "textarea","id": "description", "label": "Description"  }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "quality",  "label": "Quality / Star" },
            { "value": "delivery", "label": "Delivery / Truck" },
            { "value": "return",   "label": "Returns / Refresh" },
            { "value": "support",  "label": "Support / Headset" },
            { "value": "secure",   "label": "Secure / Shield" },
            { "value": "check",    "label": "Check / Tick" }
          ],
          "default": "check"
        },
        { "type": "text",     "id": "title",       "label": "Title" },
        { "type": "textarea", "id": "description", "label": "Description" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why Choose Us",
      "blocks": [
        { "type": "feature", "settings": { "icon": "quality",  "title": "Premium Quality",       "description": "Carefully curated furniture and decor from top global brands." } },
        { "type": "feature", "settings": { "icon": "delivery", "title": "Fast GCC Delivery",     "description": "Delivery across Saudi Arabia, UAE & GCC within 3–7 days." } },
        { "type": "feature", "settings": { "icon": "return",   "title": "Easy Returns",          "description": "14-day hassle-free return policy on all orders." } },
        { "type": "feature", "settings": { "icon": "support",  "title": "Expert Support",        "description": "Our interior design consultants are here to help you." } }
      ]
    }
  ]
}
{% endschema %}
