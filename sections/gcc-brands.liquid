<!-- sections/gcc-brands.liquid -->
{%- liquid
  assign se_stts   = section.settings
  assign se_blocks = section.blocks
-%}

<section class="t4s-section-inner gcc-brands" style="padding:48px 0;">
  <div class="t4s-container">
    {%- if se_stts.title != blank -%}
      <h2 style="text-align:center;font-size:14px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--gcc-mid-gray,#9B9B9B);margin-bottom:32px;">
        {{ se_stts.title }}
      </h2>
    {%- endif -%}

    <div style="display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:24px 40px;" data-gcc-reveal-stagger>
      {%- for block in se_blocks -%}
        {%- if block.type == 'brand' -%}
          <div class="gcc-brand-item" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" aria-label="{{ block.settings.name }}">{%- endif -%}
            {%- if block.settings.logo != blank -%}
              <img src="{{ block.settings.logo | image_url: width: 200 }}"
                   alt="{{ block.settings.name | escape }}"
                   width="{{ block.settings.logo.width | at_most: 200 }}"
                   height="{{ block.settings.logo.height | at_most: 80 }}"
                   loading="lazy"
                   style="max-height:60px;width:auto;object-fit:contain;">
            {%- else -%}
              <span style="font-weight:700;font-size:18px;color:var(--gcc-dark-gray);">{{ block.settings.name }}</span>
            {%- endif -%}
            {%- if block.settings.link != blank -%}</a>{%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand Logos (GCC)",
  "tag": "section",
  "class": "gcc-section-brands",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Our Brands" }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        { "type": "image_picker", "id": "logo",  "label": "Logo" },
        { "type": "text",         "id": "name",  "label": "Brand Name",  "default": "Brand" },
        { "type": "url",          "id": "link",  "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand Logos (GCC)",
      "blocks": [
        { "type": "brand", "settings": { "name": "Brand 1" } },
        { "type": "brand", "settings": { "name": "Brand 2" } },
        { "type": "brand", "settings": { "name": "Brand 3" } },
        { "type": "brand", "settings": { "name": "Brand 4" } },
        { "type": "brand", "settings": { "name": "Brand 5" } }
      ]
    }
  ]
}
{% endschema %}
