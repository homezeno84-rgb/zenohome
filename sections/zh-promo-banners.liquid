{{ 'zh-sections.css' | asset_url | stylesheet_tag }}
{{ 'zh-sections.js' | asset_url | script_tag }}

{%- liquid
  assign layout = section.settings.layout | default: '2-col'
  assign pt = section.settings.padding_top | default: 48
  assign pb = section.settings.padding_bottom | default: 48
  assign gap = section.settings.gap | default: 16
-%}

<section
  class="zh-section zh-promo-banners-section"
  id="zh-promo-banners-{{ section.id }}"
  style="padding-top: {{ pt }}px; padding-bottom: {{ pb }}px;"
>
  <div class="zh-container">
    <div class="zh-promo-banners zh-promo-banners--{{ layout }}" style="gap: {{ gap }}px;">
      {%- for block in section.blocks -%}
        {%- assign text_pos = block.settings.text_position | default: 'bottom-left' -%}
        {%- assign overlay_color = block.settings.overlay_color | default: '#000000' -%}
        {%- assign overlay_opacity = block.settings.overlay_opacity | default: 30 | divided_by: 100.0 -%}
        {%- assign text_color = block.settings.text_color | default: '#ffffff' -%}
        <div class="zh-promo-banner zh-promo-banner--{{ text_pos }} zh-anim zh-anim-delay-{{ forloop.index }}" {{ block.shopify_attributes }}>
          <a href="{{ block.settings.button_url | default: '#' }}" class="zh-promo-banner__link" aria-label="{{ block.settings.heading }}">
            <div class="zh-promo-banner__media">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 1200 | image_tag:
                  class: 'zh-promo-banner__img',
                  loading: 'lazy',
                  widths: '480,800,1200',
                  sizes: '(max-width:767px) 100vw, 50vw'
                }}
              {%- else -%}
                <div class="zh-promo-banner__img-placeholder"></div>
              {%- endif -%}
              <div class="zh-promo-banner__overlay" style="background: {{ overlay_color }}; opacity: {{ overlay_opacity }};"></div>
            </div>
            <div class="zh-promo-banner__content" style="color: {{ text_color }};">
              {%- if block.settings.eyebrow != blank -%}
                <span class="zh-promo-banner__eyebrow">{{ block.settings.eyebrow }}</span>
              {%- endif -%}
              {%- if block.settings.heading != blank -%}
                <h3 class="zh-promo-banner__heading">{{ block.settings.heading }}</h3>
              {%- endif -%}
              {%- if block.settings.subheading != blank -%}
                <p class="zh-promo-banner__subheading">{{ block.settings.subheading }}</p>
              {%- endif -%}
              {%- if block.settings.button_text != blank -%}
                <span class="zh-promo-banner__btn">
                  {{ block.settings.button_text }}
                  <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </span>
              {%- endif -%}
            </div>
          </a>
        </div>
      {%- else -%}
        <p class="zh-no-blocks">Add promotional banners in the Theme Editor.</p>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  #zh-promo-banners-{{ section.id }} .zh-promo-banners {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }
  #zh-promo-banners-{{ section.id }} .zh-promo-banners--3-col {
    grid-template-columns: repeat(3, 1fr);
  }
  #zh-promo-banners-{{ section.id }} .zh-promo-banners--full-width {
    grid-template-columns: 1fr;
  }
  #zh-promo-banners-{{ section.id }} .zh-promo-banner {
    position: relative;
    border-radius: var(--zh-radius-lg, 8px);
    overflow: hidden;
  }
  #zh-promo-banners-{{ section.id }} .zh-promo-banner__link {
    display: block; position: relative;
    text-decoration: none;
  }
  #zh-promo-banners-{{ section.id }} .zh-promo-banner__media {
    position: relative;
    aspect-ratio: 4/3;
    overflow: hidden;
  }
  #zh-promo-banners-{{ section.id }} .zh-promo-banners--full-width .zh-promo-banner__media {
    aspect-ratio: 21/8;
  }
  #zh-promo-banners-{{ section.id }} .zh-promo-banner__img {
    width: 100%; height: 100%;
    object-fit: cover; display: block;
    transition: transform .55s cubic-bezier(.22,1,.36,1);
  }
  #zh-promo-banners-{{ section.id }} .zh-promo-banner__img-placeholder {
    width: 100%; height: 100%;
    background: linear-gradient(135deg, var(--zh-dark, #1A1A2E), var(--zh-dark-light, #2A2A40));
  }
  #zh-promo-banners-{{ section.id }} .zh-promo-banner:hover .zh-promo-banner__img {
    transform: scale(1.05);
  }
  #zh-promo-banners-{{ section.id }} .zh-promo-banner__overlay {
    position: absolute; inset: 0; pointer-events: none;
  }
  #zh-promo-banners-{{ section.id }} .zh-promo-banner__content {
    position: absolute; inset: 0;
    padding: 28px 32px;
    display: flex; flex-direction: column;
    gap: 8px;
  }
  #zh-promo-banners-{{ section.id }} .zh-promo-banner--top-left .zh-promo-banner__content {
    justify-content: flex-start; align-items: flex-start;
  }
  #zh-promo-banners-{{ section.id }} .zh-promo-banner--center .zh-promo-banner__content {
    justify-content: center; align-items: center; text-align: center;
  }
  #zh-promo-banners-{{ section.id }} .zh-promo-banner--bottom-left .zh-promo-banner__content {
    justify-content: flex-end; align-items: flex-start;
  }
  #zh-promo-banners-{{ section.id }} .zh-promo-banner--bottom-right .zh-promo-banner__content {
    justify-content: flex-end; align-items: flex-end; text-align: right;
  }
  [dir="rtl"] #zh-promo-banners-{{ section.id }} .zh-promo-banner--bottom-left .zh-promo-banner__content,
  [dir="rtl"] #zh-promo-banners-{{ section.id }} .zh-promo-banner--top-left .zh-promo-banner__content {
    align-items: flex-end; text-align: right;
  }
  [dir="rtl"] #zh-promo-banners-{{ section.id }} .zh-promo-banner--bottom-right .zh-promo-banner__content {
    align-items: flex-start; text-align: left;
  }
  #zh-promo-banners-{{ section.id }} .zh-promo-banner__eyebrow {
    font-size: .68rem; font-weight: 700;
    letter-spacing: .2em; text-transform: uppercase;
    color: var(--zh-gold, #C9A84C);
  }
  #zh-promo-banners-{{ section.id }} .zh-promo-banner__heading {
    font-family: var(--zh-font-display, 'Cormorant Garant', serif);
    font-size: clamp(1.25rem, 2.5vw, 2.25rem);
    font-weight: 600; line-height: 1.2; margin: 0;
  }
  [dir="rtl"] #zh-promo-banners-{{ section.id }} .zh-promo-banner__heading { font-family: var(--zh-font-ar, 'Cairo', sans-serif); }
  #zh-promo-banners-{{ section.id }} .zh-promo-banner__subheading {
    font-size: .9rem; opacity: .85; margin: 0; line-height: 1.5;
  }
  #zh-promo-banners-{{ section.id }} .zh-promo-banner__btn {
    display: inline-flex; align-items: center; gap: 6px;
    margin-top: 4px;
    font-size: .75rem; font-weight: 700;
    letter-spacing: .1em; text-transform: uppercase;
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
    transition: gap .25s;
  }
  #zh-promo-banners-{{ section.id }} .zh-promo-banner:hover .zh-promo-banner__btn { gap: 10px; }
  @media (max-width: 768px) {
    #zh-promo-banners-{{ section.id }} .zh-promo-banners,
    #zh-promo-banners-{{ section.id }} .zh-promo-banners--3-col {
      grid-template-columns: 1fr;
    }
    #zh-promo-banners-{{ section.id }} .zh-promo-banner__content { padding: 20px 24px; }
  }
  @media (min-width: 769px) and (max-width: 1024px) {
    #zh-promo-banners-{{ section.id }} .zh-promo-banners--3-col { grid-template-columns: repeat(2, 1fr); }
  }
</style>

{% schema %}
{
  "name": "ZH Promo Banners",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "2-col", "label": "2 Columns" },
        { "value": "3-col", "label": "3 Columns" },
        { "value": "full-width", "label": "Full Width" }
      ],
      "default": "2-col"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap (px)",
      "min": 0, "max": 40, "step": 4, "default": 16
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top (px)",
      "min": 0, "max": 120, "step": 8, "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom (px)",
      "min": 0, "max": 120, "step": 8, "default": 48
    }
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "Promo Banner",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Banner Image"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow Text"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "New Arrivals"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button URL"
        },
        {
          "type": "select",
          "id": "text_position",
          "label": "Text Position",
          "options": [
            { "value": "top-left", "label": "Top Left" },
            { "value": "center", "label": "Center" },
            { "value": "bottom-left", "label": "Bottom Left" },
            { "value": "bottom-right", "label": "Bottom Right" }
          ],
          "default": "bottom-left"
        },
        {
          "type": "color",
          "id": "overlay_color",
          "label": "Overlay Color",
          "default": "#000000"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "Overlay Opacity (%)",
          "min": 0, "max": 80, "step": 5, "default": 30
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text Color",
          "default": "#ffffff"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ZH Promo Banners",
      "blocks": [
        { "type": "banner", "settings": { "heading": "Living Room Sale", "button_text": "Shop Now" } },
        { "type": "banner", "settings": { "heading": "New Bedroom Collection", "button_text": "Explore" } }
      ]
    }
  ]
}
{% endschema %}
