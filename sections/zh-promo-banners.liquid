{% comment %}
  ZenoHome – Promo Banners
  Section: zh-promo-banners.liquid
  Supports RTL (Arabic) and LTR (English)
{% endcomment %}

{{ 'zh-premium.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign section_dir = 'ltr'
  if request.locale.iso_code == 'ar'
    assign section_dir = 'rtl'
  endif

  case section.settings.height
    when 'short'
      assign banner_height = '300px'
    when 'tall'
      assign banner_height = '500px'
    else
      assign banner_height = '400px'
  endcase
-%}

<section
  id="zh-promo-banners-{{ section.id }}"
  class="zh-promo-banners zh-section"
  dir="{{ section_dir }}"
  style="
    --zh-pb-bg: {{ section.settings.background_color }};
    --zh-pb-pt: {{ section.settings.padding_top }}px;
    --zh-pb-pb: {{ section.settings.padding_bottom }}px;
    --zh-pb-columns: {{ section.settings.columns }};
    --zh-pb-gap: {{ section.settings.gap }}px;
    --zh-pb-height: {{ banner_height }};
  "
>
  <div class="zh-container">

    {%- if section.blocks.size > 0 -%}
      <div class="zh-pb-grid">
        {%- for block in section.blocks -%}
          {%- liquid
            assign overlay_alpha = block.settings.overlay_opacity | divided_by: 100.0
            assign overlay_rgb = block.settings.overlay_color | color_extract: 'red'
            assign overlay_g = block.settings.overlay_color | color_extract: 'green'
            assign overlay_b = block.settings.overlay_color | color_extract: 'blue'

            assign banner_class = 'zh-pb-banner'
            if block.settings.featured
              assign banner_class = 'zh-pb-banner zh-pb-banner--featured'
            endif

            case block.settings.text_position
              when 'top-left'
                assign pos_class = 'zh-pb-banner--pos-top-left'
              when 'top-center'
                assign pos_class = 'zh-pb-banner--pos-top-center'
              when 'center'
                assign pos_class = 'zh-pb-banner--pos-center'
              when 'bottom-left'
                assign pos_class = 'zh-pb-banner--pos-bottom-left'
              when 'bottom-center'
                assign pos_class = 'zh-pb-banner--pos-bottom-center'
              else
                assign pos_class = 'zh-pb-banner--pos-bottom-left'
            endcase
          -%}

          <div
            class="{{ banner_class }} {{ pos_class }}"
            {{ block.shopify_attributes }}
            style="
              --zh-pb-text-color: {{ block.settings.text_color }};
              --zh-pb-text-align: {{ block.settings.text_align }};
            "
          >
            <div class="zh-pb-banner__media">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 1600
                  | image_tag:
                    loading: 'lazy',
                    class: 'zh-pb-banner__image',
                    alt: block.settings.image.alt | default: block.settings.heading | escape,
                    widths: '600, 800, 1000, 1200, 1600'
                }}
              {%- else -%}
                <div class="zh-pb-banner__placeholder">
                  {{ 'lifestyle-2' | placeholder_svg_tag: 'zh-placeholder-svg' }}
                </div>
              {%- endif -%}

              <div
                class="zh-pb-banner__overlay"
                style="background-color: rgba({{ overlay_rgb }}, {{ overlay_g }}, {{ overlay_b }}, {{ overlay_alpha }});"
              ></div>
            </div>

            <div class="zh-pb-banner__content">
              {%- if block.settings.eyebrow != blank -%}
                <p class="zh-pb-banner__eyebrow">{{ block.settings.eyebrow }}</p>
              {%- endif -%}

              {%- if block.settings.heading != blank -%}
                <h3 class="zh-pb-banner__heading">{{ block.settings.heading }}</h3>
              {%- endif -%}

              {%- if block.settings.subheading != blank -%}
                <p class="zh-pb-banner__subheading">{{ block.settings.subheading }}</p>
              {%- endif -%}

              {%- if block.settings.cta_text != blank -%}
                <a
                  href="{{ block.settings.cta_url | default: '#' }}"
                  class="zh-pb-banner__cta zh-pb-banner__cta--{{ block.settings.cta_style }}"
                >
                  {{ block.settings.cta_text }}
                </a>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="zh-empty-state">
        <p>Add banner blocks in the theme editor.</p>
      </div>
    {%- endif -%}

  </div>
</section>

<style>
  #zh-promo-banners-{{ section.id }} {
    background-color: var(--zh-pb-bg, #FFFFFF);
    padding-top: var(--zh-pb-pt, 48px);
    padding-bottom: var(--zh-pb-pb, 48px);
  }

  #zh-promo-banners-{{ section.id }} .zh-container {
    max-width: 1400px;
    margin: 0 auto;
    padding-inline: clamp(16px, 4vw, 64px);
  }

  #zh-promo-banners-{{ section.id }} .zh-pb-grid {
    display: grid;
    grid-template-columns: repeat(var(--zh-pb-columns, 2), 1fr);
    gap: var(--zh-pb-gap, 16px);
  }

  #zh-promo-banners-{{ section.id }} .zh-pb-banner {
    position: relative;
    overflow: hidden;
    border-radius: 6px;
    height: var(--zh-pb-height, 400px);
  }

  #zh-promo-banners-{{ section.id }} .zh-pb-banner--featured {
    grid-column: span 2;
  }

  #zh-promo-banners-{{ section.id }} .zh-pb-banner__media {
    position: absolute;
    inset: 0;
  }

  #zh-promo-banners-{{ section.id }} .zh-pb-banner__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  #zh-promo-banners-{{ section.id }} .zh-pb-banner:hover .zh-pb-banner__image {
    transform: scale(1.04);
  }

  #zh-promo-banners-{{ section.id }} .zh-pb-banner__placeholder {
    width: 100%;
    height: 100%;
    background: #EDE8DF;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #zh-promo-banners-{{ section.id }} .zh-placeholder-svg {
    width: 100%;
    height: 100%;
    opacity: 0.3;
  }

  #zh-promo-banners-{{ section.id }} .zh-pb-banner__overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  #zh-promo-banners-{{ section.id }} .zh-pb-banner__content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    padding: 36px 40px;
    color: var(--zh-pb-text-color, #ffffff);
    text-align: var(--zh-pb-text-align, left);
    gap: 10px;
  }

  /* Text position variants */
  #zh-promo-banners-{{ section.id }} .zh-pb-banner--pos-top-left .zh-pb-banner__content {
    justify-content: flex-start;
    align-items: flex-start;
  }

  #zh-promo-banners-{{ section.id }} .zh-pb-banner--pos-top-center .zh-pb-banner__content {
    justify-content: flex-start;
    align-items: center;
    text-align: center;
  }

  #zh-promo-banners-{{ section.id }} .zh-pb-banner--pos-center .zh-pb-banner__content {
    justify-content: center;
    align-items: center;
    text-align: center;
  }

  #zh-promo-banners-{{ section.id }} .zh-pb-banner--pos-bottom-left .zh-pb-banner__content {
    justify-content: flex-end;
    align-items: flex-start;
  }

  #zh-promo-banners-{{ section.id }} .zh-pb-banner--pos-bottom-center .zh-pb-banner__content {
    justify-content: flex-end;
    align-items: center;
    text-align: center;
  }

  #zh-promo-banners-{{ section.id }} .zh-pb-banner__eyebrow {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.85;
    margin: 0;
    color: inherit;
  }

  #zh-promo-banners-{{ section.id }} .zh-pb-banner__heading {
    font-size: clamp(1.25rem, 2.5vw, 2rem);
    font-weight: 400;
    line-height: 1.15;
    margin: 0;
    color: inherit;
  }

  #zh-promo-banners-{{ section.id }} .zh-pb-banner__subheading {
    font-size: 0.9rem;
    opacity: 0.85;
    margin: 0;
    color: inherit;
    line-height: 1.5;
    max-width: 40ch;
  }

  #zh-promo-banners-{{ section.id }} .zh-pb-banner__cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 12px 24px;
    border-radius: 3px;
    margin-top: 8px;
    transition: all 0.25s ease;
    width: fit-content;
  }

  #zh-promo-banners-{{ section.id }} .zh-pb-banner__cta--gold {
    background: #C9A84C;
    color: #fff;
    border: 1.5px solid #C9A84C;
  }

  #zh-promo-banners-{{ section.id }} .zh-pb-banner__cta--gold:hover {
    background: #b8962e;
    border-color: #b8962e;
  }

  #zh-promo-banners-{{ section.id }} .zh-pb-banner__cta--white {
    background: #fff;
    color: #1A1A1A;
    border: 1.5px solid #fff;
  }

  #zh-promo-banners-{{ section.id }} .zh-pb-banner__cta--white:hover {
    background: transparent;
    color: #fff;
  }

  #zh-promo-banners-{{ section.id }} .zh-pb-banner__cta--outline-white {
    background: transparent;
    color: #fff;
    border: 1.5px solid rgba(255, 255, 255, 0.8);
  }

  #zh-promo-banners-{{ section.id }} .zh-pb-banner__cta--outline-white:hover {
    background: rgba(255, 255, 255, 0.15);
    border-color: #fff;
  }

  #zh-promo-banners-{{ section.id }} .zh-empty-state {
    text-align: center;
    padding: 60px;
    color: #999;
    border: 2px dashed #ddd;
    border-radius: 6px;
  }

  @media (max-width: 768px) {
    #zh-promo-banners-{{ section.id }} .zh-pb-grid {
      grid-template-columns: 1fr;
    }

    #zh-promo-banners-{{ section.id }} .zh-pb-banner--featured {
      grid-column: span 1;
    }

    #zh-promo-banners-{{ section.id }} .zh-pb-banner__content {
      padding: 24px 28px;
    }
  }
</style>

<script src="{{ 'zh-premium.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Promo Banners",
  "tag": "section",
  "class": "zh-section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "options": [
        { "value": "1", "label": "1 Column" },
        { "value": "2", "label": "2 Columns" },
        { "value": "3", "label": "3 Columns" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Banner Height",
      "options": [
        { "value": "short", "label": "Short (300px)" },
        { "value": "medium", "label": "Medium (400px)" },
        { "value": "tall", "label": "Tall (500px)" }
      ],
      "default": "medium"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap Between Banners",
      "min": 8,
      "max": 32,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section Background",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "Banner",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background Image"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow Text"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading"
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "Button Text",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "cta_url",
          "label": "Button URL"
        },
        {
          "type": "select",
          "id": "cta_style",
          "label": "Button Style",
          "options": [
            { "value": "gold", "label": "Gold" },
            { "value": "white", "label": "White" },
            { "value": "outline-white", "label": "Outline White" }
          ],
          "default": "gold"
        },
        {
          "type": "header",
          "content": "Overlay"
        },
        {
          "type": "color",
          "id": "overlay_color",
          "label": "Overlay Color",
          "default": "#000000"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "Overlay Opacity",
          "min": 0,
          "max": 70,
          "step": 5,
          "unit": "%",
          "default": 30
        },
        {
          "type": "header",
          "content": "Text"
        },
        {
          "type": "select",
          "id": "text_align",
          "label": "Text Alignment",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "left"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text Color",
          "default": "#ffffff"
        },
        {
          "type": "select",
          "id": "text_position",
          "label": "Text Position",
          "options": [
            { "value": "top-left", "label": "Top Left" },
            { "value": "top-center", "label": "Top Center" },
            { "value": "center", "label": "Center" },
            { "value": "bottom-left", "label": "Bottom Left" },
            { "value": "bottom-center", "label": "Bottom Center" }
          ],
          "default": "bottom-left"
        },
        {
          "type": "header",
          "content": "Options"
        },
        {
          "type": "checkbox",
          "id": "featured",
          "label": "Featured (spans 2 columns)",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Promo Banners",
      "blocks": [
        {
          "type": "banner",
          "settings": {
            "heading": "New Arrivals",
            "cta_text": "Shop Now"
          }
        },
        {
          "type": "banner",
          "settings": {
            "heading": "Sale Up to 50%",
            "cta_text": "Explore"
          }
        }
      ]
    }
  ]
}
{% endschema %}
