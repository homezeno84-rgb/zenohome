</section>

<style>
  #shopify-section-{{ section.id }} .zh-trust-badges {
    width: 100%;
  }

  /* Bar style */
  #shopify-section-{{ section.id }} .zh-badges-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-evenly;
    gap: 24px;
  }

  #shopify-section-{{ section.id }} .zh-badge--bar {
    display: flex;
    align-items: center;
    gap: 14px;
    flex: 0 0 auto;
  }

  #shopify-section-{{ section.id }} .zh-badge--bar .zh-badge-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  /* Cards style */
  #shopify-section-{{ section.id }} .zh-badges-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 20px;
  }

  #shopify-section-{{ section.id }} .zh-badge--card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 28px 20px;
    background: #fff;
    border: 1px solid rgba(0,0,0,0.08);
    border-radius: 12px;
    gap: 14px;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    cursor: default;
  }

  #shopify-section-{{ section.id }} .zh-badge--card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(0,0,0,0.08);
  }

  #shopify-section-{{ section.id }} .zh-badge--card .zh-badge-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  /* Icons-only style */
  #shopify-section-{{ section.id }} .zh-badges-icons-only {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 32px;
  }

  #shopify-section-{{ section.id }} .zh-badge--icon-only {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    cursor: default;
  }

  #shopify-section-{{ section.id }} .zh-badge--icon-only .zh-badge-hover-title {
    font-size: 13px;
    font-weight: 600;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.2s ease, transform 0.2s ease;
    text-align: center;
    max-width: 100px;
  }

  #shopify-section-{{ section.id }} .zh-badge--icon-only:hover .zh-badge-hover-title {
    opacity: 1;
    transform: translateY(0);
  }

  /* Shared */
  #shopify-section-{{ section.id }} .zh-badge-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .zh-badge-icon svg {
    display: block;
  }

  #shopify-section-{{ section.id }} .zh-badge-icon-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .zh-badge-title {
    font-size: 15px;
    font-weight: 700;
    line-height: 1.3;
    display: block;
  }

  #shopify-section-{{ section.id }} .zh-badge-subtitle {
    font-size: 13px;
    opacity: 0.7;
    display: block;
    line-height: 1.4;
  }

  @media (max-width: 639px) {
    #shopify-section-{{ section.id }} .zh-badges-bar {
      justify-content: flex-start;
    }
    #shopify-section-{{ section.id }} .zh-badge--bar {
      flex: 0 0 calc(50% - 12px);
    }
  }
</style>

<script src="{{ 'zh-premium.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Trust Badges",
  "tag": "section",
  "class": "zh-section",
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Display Style",
      "options": [
        { "value": "bar", "label": "Bar" },
        { "value": "cards", "label": "Cards" },
        { "value": "icons-only", "label": "Icons Only" }
      ],
      "default": "bar"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "border_top",
      "label": "Show Top Border",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "border_bottom",
      "label": "Show Bottom Border",
      "default": true
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon Color",
      "default": "#C9A84C"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#333333"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 28,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 28,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "limit": 8,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck", "label": "Truck / Delivery" },
            { "value": "shield", "label": "Shield / Secure" },
            { "value": "refresh", "label": "Refresh / Returns" },
            { "value": "lock", "label": "Lock / Payment" },
            { "value": "award", "label": "Award / Quality" },
            { "value": "clock", "label": "Clock / Fast" },
            { "value": "phone", "label": "Phone / Support" },
            { "value": "star", "label": "Star / Rating" }
          ],
          "default": "truck"
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom Icon Image (overrides icon select)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Free Shipping"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "On orders over SAR 200"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Badges",
      "blocks": [
        { "type": "badge", "settings": { "icon": "truck", "title": "Free Shipping", "subtitle": "On orders over SAR 200" } },
        { "type": "badge", "settings": { "icon": "refresh", "title": "30-Day Returns", "subtitle": "Hassle-free returns" } },
        { "type": "badge", "settings": { "icon": "shield", "title": "Authentic Products", "subtitle": "Guaranteed quality" } },
        { "type": "badge", "settings": { "icon": "lock", "title": "Secure Payment", "subtitle": "Encrypted & safe" } }
      ]
    }
  ]
}
{% endschema %}
