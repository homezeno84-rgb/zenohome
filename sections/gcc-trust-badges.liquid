{{ 'zh-sections.css' | asset_url | stylesheet_tag }}
{{ 'zh-sections.js' | asset_url | script_tag }}

{%- liquid
  assign pt = section.settings.padding_top | default: 48
  assign pb = section.settings.padding_bottom | default: 48
  assign layout = section.settings.layout | default: 'horizontal'
-%}

<section
  class="zh-section zh-trust-section"
  id="zh-trust-{{ section.id }}"
  style="padding-top:{{ pt }}px;padding-bottom:{{ pb }}px;background:{{ section.settings.background_color | default: '#ffffff' }};"
>
  <div class="zh-container">
    {%- if section.settings.title != blank -%}
      <header class="zh-section-header zh-anim">
        <h2 class="zh-section-title" style="font-size:1.5rem;">{{ section.settings.title }}</h2>
        <span class="zh-section-divider"></span>
      </header>
    {%- endif -%}
    <div class="zh-trust-badges zh-trust-badges--{{ layout }}">
      {%- for block in section.blocks -%}
        <div class="zh-trust-badge zh-anim zh-anim-delay-{{ forloop.index | modulo: 5 | plus: 1 }}" {{ block.shopify_attributes }}>
          <div class="zh-trust-badge__icon" style="color:{{ block.settings.icon_color | default: '#C9A84C' }};">
            {%- if block.settings.icon != blank -%}
              <i class="{{ block.settings.icon }}" aria-hidden="true"></i>
            {%- else -%}
              <svg width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            {%- endif -%}
          </div>
          <div class="zh-trust-badge__text">
            {%- if block.settings.title != blank -%}
              <h3 class="zh-trust-badge__title">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.description != blank -%}
              <p class="zh-trust-badge__desc">{{ block.settings.description }}</p>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  #zh-trust-{{ section.id }} .zh-trust-badges {
    display: flex; flex-wrap: wrap; gap: 24px;
    justify-content: center; align-items: flex-start;
  }
  #zh-trust-{{ section.id }} .zh-trust-badges--grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  }
  #zh-trust-{{ section.id }} .zh-trust-badge {
    display: flex; align-items: center; gap: 16px;
    flex: 1 1 200px; max-width: 280px;
    padding: 20px 24px;
    border-radius: var(--zh-radius-lg,8px);
    background: #fff;
    border: 1px solid var(--zh-border,#e8e8e8);
    transition: box-shadow .3s, transform .3s;
  }
  #zh-trust-{{ section.id }} .zh-trust-badges--grid .zh-trust-badge { max-width: none; flex: none; }
  #zh-trust-{{ section.id }} .zh-trust-badge:hover {
    box-shadow: var(--zh-shadow-md);
    transform: translateY(-3px);
  }
  #zh-trust-{{ section.id }} .zh-trust-badge__icon {
    flex-shrink: 0; font-size: 2rem; line-height: 1;
    width: 52px; height: 52px;
    display: flex; align-items: center; justify-content: center;
    background: var(--zh-gold-xlight,#F5EDD4);
    border-radius: 50%;
  }
  #zh-trust-{{ section.id }} .zh-trust-badge__title {
    font-family: var(--zh-font-display,'Cormorant Garant',serif);
    font-size: 1rem; font-weight: 700;
    color: var(--zh-dark,#1A1A2E); margin: 0 0 4px;
  }
  [dir="rtl"] #zh-trust-{{ section.id }} .zh-trust-badge__title { font-family: var(--zh-font-ar,'Cairo',sans-serif); }
  #zh-trust-{{ section.id }} .zh-trust-badge__desc {
    font-size: .8rem; color: var(--zh-text-mid,#555);
    line-height: 1.5; margin: 0;
  }
  @media (max-width: 640px) {
    #zh-trust-{{ section.id }} .zh-trust-badge { flex-direction: column; align-items: center; text-align: center; flex: 1 1 140px; }
    [dir="rtl"] #zh-trust-{{ section.id }} .zh-trust-badge { align-items: center; }
  }
</style>

{% schema %}
{
  "name": "GCC Trust Badges",
  "settings": [
    { "type": "text", "id": "title", "label": "Section Title (optional)" },
    { "type": "select", "id": "layout", "label": "Layout", "options": [{ "value": "horizontal", "label": "Horizontal (flex)" }, { "value": "grid", "label": "Grid" }], "default": "horizontal" },
    { "type": "color", "id": "background_color", "label": "Background Color", "default": "#ffffff" },
    { "type": "range", "id": "padding_top", "label": "Padding Top (px)", "min": 0, "max": 120, "step": 8, "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Padding Bottom (px)", "min": 0, "max": 120, "step": 8, "default": 48 }
  ],
  "blocks": [
    {
      "type": "badge", "name": "Trust Badge",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon Class (Line Awesome)", "info": "e.g. las la-shipping-fast", "default": "las la-shipping-fast" },
        { "type": "color", "id": "icon_color", "label": "Icon Color", "default": "#C9A84C" },
        { "type": "text", "id": "title", "label": "Title", "default": "Free Shipping" },
        { "type": "text", "id": "description", "label": "Description", "default": "On orders over SAR 500" }
      ]
    }
  ],
  "presets": [{
    "name": "GCC Trust Badges",
    "blocks": [
      { "type": "badge", "settings": { "icon": "las la-shipping-fast", "title": "Free Shipping", "description": "On orders over SAR 500" } },
      { "type": "badge", "settings": { "icon": "las la-undo", "title": "Easy Returns", "description": "30-day hassle-free returns" } },
      { "type": "badge", "settings": { "icon": "las la-shield-alt", "title": "Secure Payment", "description": "100% secure transactions" } },
      { "type": "badge", "settings": { "icon": "las la-award", "title": "Premium Quality", "description": "Curated luxury pieces" } }
    ]
  }]
}
{% endschema %}
