{{ 'zh-premium.css' | asset_url | stylesheet_tag }}

<section
  id="zh-hero-slider-{{ section.id }}"
  class="zh-hero-slider zh-hero-slider--{{ section.settings.animation }}"
  data-zh-hero-slider
  data-autoplay="{{ section.settings.autoplay }}"
  data-speed="{{ section.settings.autoplay_speed }}"
  data-animation="{{ section.settings.animation }}"
  style="
    --slider-height: {{ section.settings.height }};
    --slider-height-mobile: {{ section.settings.mobile_height }};
    --pt: {{ section.settings.padding_top }}px;
    --pb: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="zh-hero-slider__track" data-zh-slider-track>
    {%- for block in section.blocks -%}
      {%- assign is_first = false -%}
      {%- if forloop.index0 == 0 -%}{%- assign is_first = true -%}{%- endif -%}
      <div
        class="zh-hero-slider__slide{% if is_first %} is-active{% endif %}"
        data-zh-slide
        data-text-align="{{ block.settings.text_align }}"
        data-content-pos="{{ block.settings.content_position }}"
        {{ block.shopify_attributes }}
      >
        {%- comment -%} Desktop image {%- endcomment -%}
        <div class="zh-hero-slider__media zh-hide-mobile">
          {%- if block.settings.image_desktop != blank -%}
            {{
              block.settings.image_desktop
              | image_url: width: 2000
              | image_tag:
                loading: 'lazy',
                fetchpriority: 'auto',
                widths: '800,1200,1600,2000',
                sizes: '100vw',
                class: 'zh-hero-slider__img',
                alt: block.settings.heading | escape
            }}
            {%- if is_first -%}
              <link
                rel="preload"
                as="image"
                href="{{ block.settings.image_desktop | image_url: width: 1600 }}"
                fetchpriority="high"
              >
            {%- endif -%}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'zh-hero-slider__img zh-placeholder-img' }}
          {%- endif -%}
        </div>

        {%- comment -%} Mobile image {%- endcomment -%}
        <div class="zh-hero-slider__media zh-hide-desktop">
          {%- if block.settings.image_mobile != blank -%}
            {{
              block.settings.image_mobile
              | image_url: width: 800
              | image_tag:
                loading: 'lazy',
                widths: '400,600,800',
                sizes: '100vw',
                class: 'zh-hero-slider__img',
                alt: block.settings.heading | escape
            }}
          {%- elsif block.settings.image_desktop != blank -%}
            {{
              block.settings.image_desktop
              | image_url: width: 800
              | image_tag:
                loading: 'lazy',
                widths: '400,600,800',
                sizes: '100vw',
                class: 'zh-hero-slider__img',
                alt: block.settings.heading | escape
            }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'zh-hero-slider__img zh-placeholder-img' }}
          {%- endif -%}
        </div>

        {%- comment -%} Overlay {%- endcomment -%}
        {%- assign overlay_opacity_decimal = block.settings.overlay_opacity | divided_by: 100.0 -%}
        <div
          class="zh-hero-slider__overlay"
          style="background-color: {{ block.settings.overlay_color }}; opacity: {{ overlay_opacity_decimal }};"
        ></div>

        {%- comment -%} Content {%- endcomment -%}
        <div
          class="zh-hero-slider__content zh-hero-slider__content--{{ block.settings.content_position }} zh-hero-slider__content--align-{{ block.settings.text_align }}"
          style="color: {{ block.settings.text_color }};"
        >
          {%- if block.settings.eyebrow != blank -%}
            <p class="zh-hero-slider__eyebrow">{{ block.settings.eyebrow }}</p>
          {%- endif -%}

          {%- if block.settings.heading != blank -%}
            <h2 class="zh-hero-slider__heading">{{ block.settings.heading }}</h2>
          {%- endif -%}

          {%- if block.settings.subheading != blank -%}
            <p class="zh-hero-slider__subheading">{{ block.settings.subheading }}</p>
          {%- endif -%}

          {%- if block.settings.cta1_text != blank or block.settings.cta2_text != blank -%}
            <div class="zh-hero-slider__ctas">
              {%- if block.settings.cta1_text != blank -%}
                <a
                  href="{{ block.settings.cta1_url | default: '#' }}"
                  class="zh-btn zh-btn--{{ block.settings.cta1_style }}"
                >
                  {{- block.settings.cta1_text -}}
                </a>
              {%- endif -%}
              {%- if block.settings.cta2_text != blank -%}
                <a
                  href="{{ block.settings.cta2_url | default: '#' }}"
                  class="zh-btn zh-btn--{{ block.settings.cta2_style }}"
                >
                  {{- block.settings.cta2_text -}}
                </a>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- comment -%} Progress bar {%- endcomment -%}
  {%- if section.settings.show_progress -%}
    <div class="zh-hero-slider__progress" data-zh-progress>
      <div class="zh-hero-slider__progress-bar" data-zh-progress-bar></div>
    </div>
  {%- endif -%}

  {%- comment -%} Navigation Arrows {%- endcomment -%}
  {%- if section.settings.show_arrows and section.blocks.size > 1 -%}
    <button
      class="zh-hero-slider__arrow zh-hero-slider__arrow--prev"
      data-zh-prev
      aria-label="{{ 'general.slider.previous_slide' | t | default: 'Previous slide' }}"
      type="button"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>
    <button
      class="zh-hero-slider__arrow zh-hero-slider__arrow--next"
      data-zh-next
      aria-label="{{ 'general.slider.next_slide' | t | default: 'Next slide' }}"
      type="button"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>
  {%- endif -%}

  {%- comment -%} Dot indicators {%- endcomment -%}
  {%- if section.settings.show_dots and section.blocks.size > 1 -%}
    <div class="zh-hero-slider__dots" data-zh-dots role="tablist" aria-label="{{ 'general.slider.slide_indicator' | t | default: 'Slide indicators' }}">
      {%- for block in section.blocks -%}
        <button
          class="zh-hero-slider__dot{% if forloop.index0 == 0 %} is-active{% endif %}"
          data-zh-dot="{{ forloop.index0 }}"
          role="tab"
          type="button"
          aria-label="{{ 'general.slider.slide_number' | t: number: forloop.index | default: 'Slide' | append: ' ' | append: forloop.index }}"
          aria-selected="{% if forloop.index0 == 0 %}true{% else %}false{% endif %}"
        ></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

<style>
  #zh-hero-slider-{{ section.id }} {
    padding-top: var(--pt, 0px);
    padding-bottom: var(--pb, 0px);
    position: relative;
    overflow: hidden;
  }

  #zh-hero-slider-{{ section.id }} .zh-hero-slider__track {
    position: relative;
    width: 100%;
    height: var(--slider-height, 700px);
    overflow: hidden;
  }

  /* Slide base */
  #zh-hero-slider-{{ section.id }} .zh-hero-slider__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.8s cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
    z-index: 0;
  }

  #zh-hero-slider-{{ section.id }} .zh-hero-slider__slide.is-active {
    opacity: 1;
    pointer-events: auto;
    z-index: 1;
  }

  /* Zoom animation for active slide */
  #zh-hero-slider-{{ section.id }}.zh-hero-slider--zoom .zh-hero-slider__slide.is-active .zh-hero-slider__img {
    animation: zh-hero-zoom {{ section.settings.autoplay_speed }}s ease forwards;
  }

  @keyframes zh-hero-zoom {
    from { transform: scale(1); }
    to   { transform: scale(1.08); }
  }

  /* Slide animation */
  #zh-hero-slider-{{ section.id }}.zh-hero-slider--slide .zh-hero-slider__slide {
    transform: translateX(100%);
    opacity: 1;
    transition: transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
  }

  #zh-hero-slider-{{ section.id }}.zh-hero-slider--slide .zh-hero-slider__slide.is-active {
    transform: translateX(0);
  }

  #zh-hero-slider-{{ section.id }}.zh-hero-slider--slide .zh-hero-slider__slide.is-leaving {
    transform: translateX(-100%);
  }

  [dir="rtl"] #zh-hero-slider-{{ section.id }}.zh-hero-slider--slide .zh-hero-slider__slide {
    transform: translateX(-100%);
  }
  [dir="rtl"] #zh-hero-slider-{{ section.id }}.zh-hero-slider--slide .zh-hero-slider__slide.is-leaving {
    transform: translateX(100%);
  }

  /* Media containers */
  #zh-hero-slider-{{ section.id }} .zh-hero-slider__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  #zh-hero-slider-{{ section.id }} .zh-hero-slider__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #zh-hero-slider-{{ section.id }} .zh-placeholder-img {
    width: 100%;
    height: 100%;
  }

  /* Overlay */
  #zh-hero-slider-{{ section.id }} .zh-hero-slider__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  /* Content positioning */
  #zh-hero-slider-{{ section.id }} .zh-hero-slider__content {
    position: absolute;
    z-index: 2;
    padding: 2rem 2.5rem;
    max-width: 700px;
    width: 100%;
  }

  #zh-hero-slider-{{ section.id }} .zh-hero-slider__content--center {
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
  }

  #zh-hero-slider-{{ section.id }} .zh-hero-slider__content--bottom-left {
    bottom: 3.5rem;
    left: 3.5rem;
  }

  #zh-hero-slider-{{ section.id }} .zh-hero-slider__content--bottom-center {
    bottom: 3.5rem;
    left: 50%;
    transform: translateX(-50%);
    text-align: center;
  }

  #zh-hero-slider-{{ section.id }} .zh-hero-slider__content--bottom-right {
    bottom: 3.5rem;
    right: 3.5rem;
    left: auto;
    text-align: right;
  }

  /* Text alignment overrides */
  #zh-hero-slider-{{ section.id }} .zh-hero-slider__content--align-left  { text-align: left; }
  #zh-hero-slider-{{ section.id }} .zh-hero-slider__content--align-center { text-align: center; }
  #zh-hero-slider-{{ section.id }} .zh-hero-slider__content--align-right  { text-align: right; }

  /* RTL positioning fixes */
  [dir="rtl"] #zh-hero-slider-{{ section.id }} .zh-hero-slider__content--bottom-left {
    left: auto;
    right: 3.5rem;
  }
  [dir="rtl"] #zh-hero-slider-{{ section.id }} .zh-hero-slider__content--bottom-right {
    right: auto;
    left: 3.5rem;
    text-align: left;
  }

  /* Typography */
  #zh-hero-slider-{{ section.id }} .zh-hero-slider__eyebrow {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    margin: 0 0 0.85rem;
    opacity: 0.85;
  }

  #zh-hero-slider-{{ section.id }} .zh-hero-slider__heading {
    font-size: clamp(2rem, 5vw, 3.75rem);
    font-weight: 700;
    line-height: 1.08;
    margin: 0 0 1rem;
    letter-spacing: -0.01em;
  }

  #zh-hero-slider-{{ section.id }} .zh-hero-slider__subheading {
    font-size: clamp(0.9rem, 1.8vw, 1.1rem);
    opacity: 0.88;
    line-height: 1.65;
    margin: 0 0 2rem;
    max-width: 520px;
  }

  #zh-hero-slider-{{ section.id }} .zh-hero-slider__content--align-center .zh-hero-slider__subheading {
    margin-left: auto;
    margin-right: auto;
  }

  /* CTA buttons row */
  #zh-hero-slider-{{ section.id }} .zh-hero-slider__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    align-items: center;
  }

  #zh-hero-slider-{{ section.id }} .zh-hero-slider__content--align-center .zh-hero-slider__ctas { justify-content: center; }
  #zh-hero-slider-{{ section.id }} .zh-hero-slider__content--align-right  .zh-hero-slider__ctas { justify-content: flex-end; }

  /* Button variants */
  #zh-hero-slider-{{ section.id }} .zh-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.8rem 2rem;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 2px;
    transition: background 0.2s, color 0.2s, border-color 0.2s, transform 0.15s;
    cursor: pointer;
    white-space: nowrap;
    border: 2px solid transparent;
  }

  #zh-hero-slider-{{ section.id }} .zh-btn:hover { transform: translateY(-1px); }

  #zh-hero-slider-{{ section.id }} .zh-btn--gold            { background: #C9A84C; color: #fff; border-color: #C9A84C; }
  #zh-hero-slider-{{ section.id }} .zh-btn--gold:hover       { background: #b8942e; border-color: #b8942e; }
  #zh-hero-slider-{{ section.id }} .zh-btn--white            { background: #fff; color: #111; border-color: #fff; }
  #zh-hero-slider-{{ section.id }} .zh-btn--white:hover      { background: #f0f0f0; border-color: #f0f0f0; }
  #zh-hero-slider-{{ section.id }} .zh-btn--outline-white    { background: transparent; color: #fff; border-color: #fff; }
  #zh-hero-slider-{{ section.id }} .zh-btn--outline-white:hover { background: rgba(255,255,255,0.15); }
  #zh-hero-slider-{{ section.id }} .zh-btn--outline-gold     { background: transparent; color: #C9A84C; border-color: #C9A84C; }
  #zh-hero-slider-{{ section.id }} .zh-btn--outline-gold:hover { background: rgba(201,168,76,0.12); }

  /* Navigation arrows */
  #zh-hero-slider-{{ section.id }} .zh-hero-slider__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    background: rgba(255,255,255,0.12);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border: 1px solid rgba(255,255,255,0.28);
    color: #fff;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s;
    padding: 0;
  }

  #zh-hero-slider-{{ section.id }} .zh-hero-slider__arrow:hover {
    background: rgba(255,255,255,0.28);
  }

  #zh-hero-slider-{{ section.id }} .zh-hero-slider__arrow--prev { left: 1.5rem; }
  #zh-hero-slider-{{ section.id }} .zh-hero-slider__arrow--next { right: 1.5rem; }

  [dir="rtl"] #zh-hero-slider-{{ section.id }} .zh-hero-slider__arrow--prev { left: auto; right: 1.5rem; }
  [dir="rtl"] #zh-hero-slider-{{ section.id }} .zh-hero-slider__arrow--next { right: auto; left: 1.5rem; }

  /* Dot indicators */
  #zh-hero-slider-{{ section.id }} .zh-hero-slider__dots {
    position: absolute;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  #zh-hero-slider-{{ section.id }} .zh-hero-slider__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255,255,255,0.45);
    border: none;
    cursor: pointer;
    transition: background 0.2s, transform 0.2s, width 0.2s;
    padding: 0;
    flex-shrink: 0;
  }

  #zh-hero-slider-{{ section.id }} .zh-hero-slider__dot.is-active {
    background: #C9A84C;
    transform: scale(1.35);
  }

  /* Progress bar */
  #zh-hero-slider-{{ section.id }} .zh-hero-slider__progress {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: rgba(255,255,255,0.18);
    z-index: 10;
    overflow: hidden;
  }

  #zh-hero-slider-{{ section.id }} .zh-hero-slider__progress-bar {
    height: 100%;
    background: #C9A84C;
    width: 0%;
    transform-origin: left;
  }

  /* Mobile overrides */
  @media (max-width: 767px) {
    #zh-hero-slider-{{ section.id }} .zh-hero-slider__track {
      height: var(--slider-height-mobile, 400px);
    }

    #zh-hero-slider-{{ section.id }} .zh-hero-slider__content {
      padding: 1.25rem 1.25rem;
    }

    #zh-hero-slider-{{ section.id }} .zh-hero-slider__content--bottom-left,
    #zh-hero-slider-{{ section.id }} .zh-hero-slider__content--bottom-right {
      bottom: 2.5rem;
      left: 1.25rem;
      right: 1.25rem;
      text-align: start;
    }

    #zh-hero-slider-{{ section.id }} .zh-hero-slider__content--bottom-center {
      bottom: 2.5rem;
    }

    #zh-hero-slider-{{ section.id }} .zh-hero-slider__arrow {
      width: 40px;
      height: 40px;
    }

    #zh-hero-slider-{{ section.id }} .zh-hero-slider__arrow--prev { left: 0.6rem; }
    #zh-hero-slider-{{ section.id }} .zh-hero-slider__arrow--next { right: 0.6rem; }

    [dir="rtl"] #zh-hero-slider-{{ section.id }} .zh-hero-slider__arrow--prev { left: auto; right: 0.6rem; }
    [dir="rtl"] #zh-hero-slider-{{ section.id }} .zh-hero-slider__arrow--next { right: auto; left: 0.6rem; }
  }

  /* Responsive image visibility */
  .zh-hide-mobile  { display: block; }
  .zh-hide-desktop { display: none; }

  @media (max-width: 767px) {
    .zh-hide-mobile  { display: none !important; }
    .zh-hide-desktop { display: block !important; }
  }
</style>

<script src="{{ 'zh-premium.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "ZH Hero Slider",
  "tag": "section",
  "class": "zh-section-hero-slider",
  "max_blocks": 8,
  "settings": [
    {
      "type": "select",
      "id": "height",
      "label": "Desktop Height",
      "options": [
        { "value": "400px", "label": "Small (400px)" },
        { "value": "550px", "label": "Medium (550px)" },
        { "value": "700px", "label": "Large (700px)" },
        { "value": "100vh", "label": "Full Screen (100vh)" }
      ],
      "default": "700px"
    },
    {
      "type": "select",
      "id": "mobile_height",
      "label": "Mobile Height",
      "options": [
        { "value": "280px", "label": "Small (280px)" },
        { "value": "400px", "label": "Medium (400px)" },
        { "value": "100vh", "label": "Full Screen (100vh)" }
      ],
      "default": "400px"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "Slide Animation",
      "options": [
        { "value": "fade",  "label": "Fade" },
        { "value": "slide", "label": "Slide" },
        { "value": "zoom",  "label": "Zoom" }
      ],
      "default": "fade"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay Speed",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show Navigation Arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show Dot Indicators",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_progress",
      "label": "Show Progress Bar",
      "default": false
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "header",
          "content": "Images"
        },
        {
          "type": "image_picker",
          "id": "image_desktop",
          "label": "Desktop Image"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile Image (optional)"
        },
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow Text",
          "default": "New Collection"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Elevate Your Living Space"
        },
        {
          "type": "textarea",
          "id": "subheading",
          "label": "Subheading"
        },
        {
          "type": "header",
          "content": "Primary Button"
        },
        {
          "type": "text",
          "id": "cta1_text",
          "label": "Primary Button Text",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "cta1_url",
          "label": "Primary Button URL"
        },
        {
          "type": "select",
          "id": "cta1_style",
          "label": "Primary Button Style",
          "options": [
            { "value": "gold",          "label": "Gold" },
            { "value": "white",         "label": "White" },
            { "value": "outline-white", "label": "Outline White" },
            { "value": "outline-gold",  "label": "Outline Gold" }
          ],
          "default": "gold"
        },
        {
          "type": "header",
          "content": "Secondary Button (optional)"
        },
        {
          "type": "text",
          "id": "cta2_text",
          "label": "Secondary Button Text"
        },
        {
          "type": "url",
          "id": "cta2_url",
          "label": "Secondary Button URL"
        },
        {
          "type": "select",
          "id": "cta2_style",
          "label": "Secondary Button Style",
          "options": [
            { "value": "gold",          "label": "Gold" },
