    "custom_css": [
      "/* ===== Side dropdown for all Collection menus ===== */ /* إظهار القوائم المنسدلة بشكل جانبي بدل عمودي */.site-nav__dropdown,.nt_menu .sub-menu,.header__menu .list-menu .sub-menu {position: absolute !important; top: 0 !important; left: 100% !important; /* يمين */ min-width: 220px; z-index: 9999; display: none; white-space: nowrap;}",
      " /* إظهار القائمة عند التحويم */.site-nav li:hover > .site-nav__dropdown,.nt_menu li:hover > .sub-menu,.header__menu .list-menu li:hover > .sub-menu {display: block !important;}",
      " /* القوائم المتداخلة (المستوى الثاني/الثالث) تفتح للجانب */.site-nav__dropdown li .site-nav__dropdown,.sub-menu li .sub-menu {top: 0 !important; left: 100% !important;}",
      " /* دعم RTL (عربي) لو قلبت الموقع من اليمين لليسار */html[dir=\"rtl\"] .site-nav__dropdown,html[dir=\"rtl\"] .nt_menu .sub-menu,html[dir=\"rtl\"] .header__menu .list-menu .sub-menu {right: 100% !important; left: auto !important;}"
